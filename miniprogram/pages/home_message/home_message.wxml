<!--pages/home_message/home_message.wxml-->
<view class="page-container">
  <view class="msg-list" wx:if="{{conversations.length > 0}}">
    <view 
      class="msg-item {{item.isProductEntry ? 'product-entry' : ''}}" 
      wx:for="{{conversations}}" 
      wx:key="_id"
      bindtap="openChat"
      data-key="{{item._id}}"
      data-commodity-id="{{item.commodityId}}"
      data-is-product-entry="{{item.isProductEntry}}"
    >
      <image class="msg-avatar" src="{{item.otherAvatar || '/images/default-avatar.png'}}"/>
      <view class="msg-content">
        <view class="msg-header">
          <view class="msg-name-row">
            <text class="msg-name">{{item.otherName || '卖家'}}</text>
            <view class="seller-tag" wx:if="{{item.isProductEntry}}">我发布的</view>
            <view class="seller-tag buyer-tag" wx:if="{{item.isBuyer}}">咨询中</view>
          </view>
          <text class="msg-time">{{item.lastTimeText}}</text>
        </view>
        <view class="msg-body">
          <text class="msg-preview">{{item.displayPreview}}</text>
          <view class="msg-badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount}}</view>
        </view>
        <view class="msg-product-tag" wx:if="{{item.commodityTitle}}">
          <image wx:if="{{item.commodityImage}}" class="tag-thumb" src="{{item.commodityImage}}" mode="aspectFill"/>
          <text class="tag-text">{{item.commodityTitle}}</text>
          <text class="tag-price" wx:if="{{item.commodityPrice}}">¥{{item.commodityPrice}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">💬</text>
    <text class="empty-title">暂无消息</text>
    <text class="empty-desc">快去首页浏览商品，与感兴趣的卖家聊聊吧</text>
    <button class="empty-btn" bindtap="goHome">去首页逛逛</button>
  </view>
</view>