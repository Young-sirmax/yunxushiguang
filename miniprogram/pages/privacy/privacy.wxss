/* pages/privacy/privacy.wxss */
.page-container {
  padding: 32rpx;
}

.content-card {
  padding: 48rpx 40rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
  color: var(--text);
  margin-bottom: 16rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.title::after {
  content: '';
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--primary-grad);
  margin-top: 16rpx;
}

.update-date {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary-grad);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.section-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  display: block;
  margin-bottom: 16rpx;
}

.section-text.footnote {
  font-size: 24rpx;
  color: var(--text-light);
  font-style: italic;
}

.section-list {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.list-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  padding: 6rpx 0;
  display: flex;
  align-items: flex-start;
}

.list-dot {
  color: var(--primary);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.contact-card {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.contact-item-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.agreement-tip {
  background: var(--warning-soft);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  border-left: 6rpx solid var(--warning);
  margin-top: 20rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warning);   /* 状态/提示语义，不是价格 */;
  display: block;
  margin-bottom: 10rpx;
}

.tip-content {
  font-size: 24rpx;
  color: var(--warning);   /* 状态/提示语义，不是价格 */;
  line-height: 1.7;
}

/* === 新增：小节子标题（2.1 / 2.2 等） === */
.sub-block {
  margin-top: 20rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.sub-title::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-grad);
  margin-right: 12rpx;
  flex-shrink: 0;
}