/* pages/home_about/home_about.wxss —— 关于我们（青春校园 · 专业正式） */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg) 360rpx);
  padding-bottom: 80rpx;
}

/* === 品牌头部 === */
.brand-header {
  position: relative;
  height: 520rpx;
  overflow: hidden;
}

.brand-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--primary-grad-vivid);
  border-bottom-left-radius: 56rpx;
  border-bottom-right-radius: 56rpx;
}

/* 光斑装饰 */
.brand-bg::before {
  content: '';
  position: absolute;
  top: -80rpx;
  left: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22) 0%, transparent 70%);
}

.brand-bg::after {
  content: '';
  position: absolute;
  bottom: 40rpx;
  right: -70rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--warning-rgb), 0.4) 0%, transparent 68%);
}

.brand-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 88rpx;
}

.brand-logo-wrap {
  width: 180rpx;
  height: 180rpx;
  border-radius: 44rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: var(--white);
  padding: 12rpx;
  box-shadow: 0 16rpx 48rpx rgba(var(--text-rgb), 0.28), 0 0 0 8rpx rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-logo {
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
}

.brand-name {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--white);
  letter-spacing: 6rpx;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 10rpx rgba(var(--text-rgb), 0.25);
}

.brand-sub {
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 18rpx;
  letter-spacing: 2rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: var(--white);
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 30rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
  letter-spacing: 1rpx;
}

/* === 平台使命卡片 === */
.intro-card {
  margin: -52rpx 24rpx 24rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 10rpx 40rpx rgba(var(--text-rgb), 0.08);
  position: relative;
  z-index: 2;
}

.intro-quote {
  font-size: 44rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  line-height: 1;
}

.intro-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.intro-title {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 10rpx;
}

.intro-text {
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* === 通用区块 === */
.block {
  margin: 0 24rpx 28rpx;
}

.block-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.block-title-bar {
  width: 10rpx;
  height: 32rpx;
  border-radius: 5rpx;
  background: var(--primary-grad);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.block-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.block-card {
  background: var(--white);
  border-radius: 26rpx;
  padding: 30rpx 30rpx;
  box-shadow: 0 6rpx 26rpx rgba(var(--text-rgb), 0.05);
}

.para {
  display: block;
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.85;
  text-align: justify;
}

.para + .para {
  margin-top: 18rpx;
}

/* === 核心服务 === */
.feature-list {
  background: var(--white);
  border-radius: 26rpx;
  padding: 6rpx 28rpx;
  box-shadow: 0 6rpx 26rpx rgba(var(--text-rgb), 0.05);
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--fill);
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(var(--text-rgb), 0.06);
}

.feature-icon-wrap.icon-green {
  background: var(--primary-light);
}

.feature-icon-wrap.icon-want {
  background: var(--type-idle-soft);
}

.feature-icon-wrap.icon-blue {
  background: var(--type-skill-soft);
}

.feature-icon-wrap.icon-purple {
  background: var(--type-wanted-soft);
}

.feature-icon-wrap.icon-orange {
  background: var(--price-soft);
}

.feature-icon-wrap.icon-yellow {
  background: var(--warning-soft);
}

.feature-icon {
  font-size: 40rpx;
}

.feature-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.55;
}

/* === 服务承诺 === */
.promise-card {
  background: var(--white);
  border-radius: 26rpx;
  padding: 14rpx 28rpx;
  box-shadow: 0 6rpx 26rpx rgba(var(--text-rgb), 0.05);
}

.promise-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--fill);
}

.promise-row:last-child {
  border-bottom: none;
}

.promise-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary-dark);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.promise-text {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.65;
}

/* === 联系我们 === */
.contact-section {
  margin: 0 24rpx;
}

.contact-card {
  background: var(--white);
  border-radius: 26rpx;
  padding: 10rpx 28rpx;
  box-shadow: 0 6rpx 26rpx rgba(var(--text-rgb), 0.05);
}

.contact-item {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--fill);
}

.contact-item:last-child {
  border-bottom: none;
  flex-direction: column;
}

.contact-label {
  font-size: 26rpx;
  color: var(--text-light);
  width: 150rpx;
  flex-shrink: 0;
}

.contact-value {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex: 1;
}

.contact-value.note {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
  margin-top: 8rpx;
}

.feedback-btn {
  margin-top: 24rpx;
  background: var(--primary-grad);
  color: var(--white);
  text-align: center;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
  transition: transform 0.2s;
}

.feedback-btn:active {
  transform: scale(0.97);
}

.version {
  text-align: center;
  font-size: 23rpx;
  color: var(--text-light);
  margin-top: 48rpx;
  letter-spacing: 1rpx;
}

/* 平台定位卡片 & 文案强调 & 官方微信 */
.position-card {
  margin-top: 24rpx;
}

.para-strong {
  color: var(--text);
  font-weight: 600;
}

.contact-value.wechat {
  color: var(--primary);
  font-weight: 600;
}

.feature-icon-wrap.icon-exchange {
  background: var(--type-exchange-grad);
}

.feature-icon-wrap.icon-skill {
  background: var(--type-skill-grad);
}
