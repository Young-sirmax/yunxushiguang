/* pages/home_about/home_about.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 80rpx;
}

/* 品牌头部 */
.brand-header {
  position: relative;
  height: 360rpx;
  overflow: hidden;
}

.brand-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, #07c160 0%, #06ad56 50%, #00b86b 100%);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

.brand-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.brand-logo {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.brand-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 16rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
}

/* 介绍卡片 */
.intro-card {
  margin: -60rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}

.intro-quote {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.intro-text {
  font-size: 28rpx;
  color: #555566;
  line-height: 1.7;
  font-style: italic;
}

/* 分区通用头部 */
.layer-section,
.passive-section,
.exec-section,
.psych-section {
  margin: 0 24rpx 24rpx;
}

.layer-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.layer-emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.layer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* 三层卡片 */
.layer-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border-left: 8rpx solid #07c160;
}

.layer-card:nth-child(2) {
  border-left-color: #ff6b35;
}

.layer-card:nth-child(3) {
  border-left-color: #a18cd1;
}

.layer-num {
  display: inline-block;
  font-size: 22rpx;
  color: #07c160;
  background: #f0faf3;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.layer-card:nth-child(2) .layer-num {
  color: #ff6b35;
  background: #fff3e0;
}

.layer-card:nth-child(3) .layer-num {
  color: #a18cd1;
  background: #f3eeff;
}

.layer-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 10rpx;
}

.layer-desc {
  font-size: 26rpx;
  color: #777788;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.layer-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b35;
}

/* 被动收入卡片 */
.passive-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.passive-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.passive-body {
  flex: 1;
}

.passive-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 6rpx;
}

.passive-desc {
  font-size: 24rpx;
  color: #9999aa;
  line-height: 1.5;
}

.passive-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b35;
  flex-shrink: 0;
}

.passive-price.free {
  color: #07c160;
}

/* 执行路径 */
.exec-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.exec-time {
  width: 220rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #07c160;
}

.exec-item:last-child .exec-time {
  color: #ff6b35;
}

.exec-content {
  font-size: 26rpx;
  color: #555566;
  flex: 1;
}

/* 心理卡片 */
.psych-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.psych-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #07c160;
  background: #f0faf3;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.psych-tag.free {
  color: #ff6b35;
  background: #fff3e0;
}

.psych-text {
  font-size: 26rpx;
  color: #777788;
  line-height: 1.6;
  font-style: italic;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  margin-top: 40rpx;
}