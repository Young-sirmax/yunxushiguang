/* pages/admin/admin.wxss */
.page-container {
  padding: 24rpx;
}

/* ===== 登录 ===== */
.login-card {
  margin-top: 40rpx;
  padding: 48rpx 40rpx;
  animation: fadeIn 0.3s ease;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.login-input {
  background: var(--bg);
  border-radius: 16rpx;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.login-btn {
  width: 100%;
}

/* ===== 头部 ===== */
.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.admin-title {
  font-size: 36rpx;
  font-weight: 700;
}

.admin-logout {
  font-size: 26rpx;
  color: var(--danger);
  padding: 12rpx 20rpx;
  background: rgba(255, 77, 79, 0.08);
  border-radius: 32rpx;
}

/* ===== Tab ===== */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 16rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: var(--primary-grad);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.3);
}

/* ===== 列表 ===== */
.empty-tip {
  text-align: center;
  color: var(--text-light);
  padding: 120rpx 0;
  font-size: 28rpx;
}

.verify-card {
  animation: fadeIn 0.3s ease;
}

.verify-user {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: baseline;
}

.real-name {
  color: var(--primary);
}

.user-nick {
  font-size: 26rpx;
  color: var(--text-light);
  font-weight: 400;
  margin-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-school {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.verify-time {
  font-size: 24rpx;
  color: var(--text-light);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.verify-info {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  margin-bottom: 10rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--text);
  word-break: break-all;
}

.reject-reason {
  color: var(--danger);
}

/* ===== 照片 ===== */
.verify-img-row {
  margin-bottom: 24rpx;
}

.verify-img {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.verify-img.placeholder {
  border: 2rpx dashed var(--border);
}

.placeholder-text {
  font-size: 26rpx;
  color: var(--text-light);
}

/* ===== 操作按钮 ===== */
.verify-actions {
  display: flex;
  gap: 24rpx;
}

.btn-approve {
  flex: 1;
  background: var(--primary-grad);
  color: #fff;
  border-radius: 40rpx;
  height: 76rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.3);
}

.btn-approve::after,
.btn-reject::after {
  border: none;
}

.btn-approve:active {
  transform: scale(0.97);
}

.btn-reject {
  flex: 1;
  background: linear-gradient(135deg, #ff7a8a, #f43f5e);
  color: var(--white);
  border-radius: 40rpx;
  height: 76rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 77, 79, 0.25);
}

.btn-reject:active {
  transform: scale(0.97);
}

.audited-tag {
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 40rpx;
}

.audited-tag.approved {
  background: var(--primary-light);
  color: var(--primary);
}

.audited-tag.rejected {
  background: rgba(255, 77, 79, 0.08);
  color: var(--danger);
}

/* ===== 模块切换 ===== */
.module-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.module-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 16rpx;
  transition: all 0.2s;
}

.module-item.active {
  background: var(--primary-grad);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.3);
}

/* ===== 商品审核卡片 ===== */
.commodity-card {
  animation: fadeIn 0.3s ease;
}

.commodity-top {
  display: flex;
  margin-bottom: 20rpx;
}

.commodity-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--bg);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.commodity-meta {
  flex: 1;
  min-width: 0;
}

.commodity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.commodity-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger);
  margin-bottom: 12rpx;
}

.commodity-price.want {
  color: var(--primary);
}

.commodity-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.commodity-tag {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.commodity-category {
  font-size: 24rpx;
  color: var(--text-light);
}

.commodity-desc {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.commodity-sub {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 24rpx;
}

.commodity-time {
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===================== 数据管理模块 ===================== */
.sub-bar {
  display: flex;
  padding: 6rpx;
  background: #eef2f6;
  border-radius: 999rpx;
  margin: 20rpx 0;
}

.sub-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: var(--text-secondary);
  font-weight: 600;
  transition: all 0.25s ease;
}

.sub-item.active {
  background: var(--primary-grad);
  color: #fff;
  box-shadow: var(--shadow-primary);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  box-shadow: var(--shadow-sm);
}

.search-btn {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: var(--primary-grad);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: var(--shadow-primary);
}

.search-btn:active {
  transform: scale(0.95);
}

/* 商品状态 Tab */
.data-tab-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.data-tabs {
  display: inline-flex;
}

.data-tab {
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #fff;
  border-radius: 999rpx;
  font-weight: 500;
  box-shadow: var(--shadow-sm);
}

.data-tab.active {
  background: var(--primary-grad);
  color: #fff;
}

/* 类型筛选 chips */
.type-chips {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.type-chip {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #fff;
  border-radius: 999rpx;
  box-shadow: var(--shadow-sm);
}

.type-chip.active {
  background: var(--primary-grad);
  color: #fff;
}

.type-chip.want.active {
  background: var(--want-grad);
}

/* 通用数据卡片 */
.data-card,
.user-card {
  margin-bottom: 20rpx;
}

.data-top,
.user-head {
  display: flex;
  align-items: flex-start;
}

.data-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.data-meta {
  flex: 1;
  min-width: 0;
}

.data-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.data-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.data-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
  font-weight: 600;
}

.data-kind.want {
  color: var(--want);
  background: var(--want-soft);
}

.data-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 8rpx;
}

.data-price.want {
  color: var(--want);
}

.data-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.data-status {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.data-status.s-pendingReview { background: var(--warning-soft); color: var(--warning); }
.data-status.s-onSale { background: var(--primary-soft); color: var(--primary); }
.data-status.s-rejected { background: var(--danger-soft); color: var(--danger); }
.data-status.s-deleted { background: #eef1f5; color: var(--text-light); }
.data-status.s-sold { background: #eef1f5; color: var(--text-light); }

.data-sub {
  font-size: 22rpx;
  color: var(--text-light);
}

.data-sub-row,
.u-info-row,
.u-time-row {
  font-size: 23rpx;
  color: var(--text-light);
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  word-break: break-all;
}

.data-time {
  flex-shrink: 0;
}

.data-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.mini-btn {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  transition: transform 0.2s ease;
}

.mini-btn:active {
  transform: scale(0.94);
}

.mini-btn.primary {
  color: var(--primary);
  background: var(--primary-soft);
}

.mini-btn.warn {
  color: #d97706;
  background: var(--warning-soft);
}

.mini-btn.danger {
  color: var(--danger);
  background: var(--danger-soft);
}

.more-btn {
  text-align: center;
  padding: 24rpx;
  font-size: 25rpx;
  color: var(--text-light);
}

/* 用户卡片 */
.data-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #f1f5f9;
  flex-shrink: 0;
  margin-right: 18rpx;
}

.u-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
}

.u-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.u-nick {
  font-size: 22rpx;
  color: var(--text-light);
}

.u-school {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.u-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  justify-content: flex-end;
}

.mini-tag {
  font-size: 19rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.mini-tag.admin { color: #6d4fdc; background: #f1ecfd; }
.mini-tag.ban { color: var(--danger); background: var(--danger-soft); }
.mini-tag.verified { color: var(--primary); background: var(--primary-soft); }

/* === 以物易物：类型筛选与标签 === */
.type-chip.exchange.active {
  background: var(--exchange-grad);
}

.data-kind.exchange {
  color: var(--exchange);
  background: var(--exchange-soft);
}

.data-price.exchange {
  color: var(--exchange);
  font-size: 26rpx;
}

/* === 技能达人标签与操作 === */
.mini-tag.expert {
  color: var(--skill);
  background: var(--skill-soft);
}

.mini-btn.expert {
  color: var(--skill);
  background: var(--skill-soft);
}
