<!--pages/home/home.wxml-->
<view class="page-container">
  <!-- 渐变头部 -->
  <view class="home-header">
    <view class="header-bg-grad"></view>
    <view class="user-info" wx:if="{{isLoggedIn}}">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}"/>
      <view class="user-meta">
        <view class="user-name-row">
          <text class="user-name">{{userInfo.nickName || '未登录'}}</text>
          <view wx:if="{{userInfo.isStudentVerified}}" class="verify-mini-badge">✓ 已认证</view>
          <view wx:elif="{{userInfo.studentVerifyStatus === 'pending'}}" class="verify-mini-badge pending">审核中</view>
        </view>
        <text class="user-school">{{userInfo.universityName || (userInfo.contact ? '点击完善资料' : '')}}</text>
      </view>
    </view>
    <view class="user-info" wx:else>
      <view class="user-avatar default-avatar">👤</view>
      <view class="user-meta">
        <text class="user-name">未登录</text>
        <text class="user-school">登录后享受完整功能</text>
      </view>
      <view class="login-action" bindtap="goLogin">登录</view>
    </view>
  </view>

  <!-- 数据统计 - 玻璃态卡片 -->
  <view class="stats-card" wx:if="{{isLoggedIn}}">
    <view class="stat-item" bindtap="goMyRelease">
      <text class="stat-num">{{stats.release}}</text>
      <text class="stat-label">我发布的</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goMyFavorite">
      <text class="stat-num">{{stats.favorite}}</text>
      <text class="stat-label">我的收藏</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goUserInfo">
      <view class="menu-icon-wrap icon-blue"><text class="menu-icon">👤</text></view>
      <text class="menu-text">个人信息</text>
      <view wx:if="{{userInfo.isStudentVerified}}" class="menu-verify-badge">✓ 已认证</view>
      <view wx:elif="{{userInfo.studentVerifyStatus === 'pending'}}" class="menu-verify-badge pending">审核中</view>
      <view wx:elif="{{isLoggedIn}}" class="menu-verify-badge unverified">未认证</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyFavorite">
      <view class="menu-icon-wrap icon-red"><text class="menu-icon">❤️</text></view>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyRelease">
      <view class="menu-icon-wrap icon-orange"><text class="menu-icon">📦</text></view>
      <text class="menu-text">我发布的信息</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyWant">
      <view class="menu-icon-wrap icon-want"><text class="menu-icon">🔍</text></view>
      <text class="menu-text">我的求购</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <view class="menu-icon-wrap icon-purple"><text class="menu-icon">🛡️</text></view>
      <text class="menu-text">认证审核管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goFeedback">
      <view class="menu-icon-wrap icon-yellow"><text class="menu-icon">📝</text></view>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPrivacy">
      <view class="menu-icon-wrap icon-gray"><text class="menu-icon">🔒</text></view>
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goAbout">
      <view class="menu-icon-wrap icon-cyan"><text class="menu-icon">ℹ️</text></view>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="logout-btn" wx:if="{{isLoggedIn}}" bindtap="logout">退出登录</button>
</view>