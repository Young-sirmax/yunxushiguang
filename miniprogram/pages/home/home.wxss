/* pages/home/home.wxss */
page {
  background: #f5f7fa;
}

.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 180rpx;
}

/* === 渐变头部 === */
.home-header {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.header-bg-grad {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, #07c160 0%, #06ad56 50%, #00b86b 100%);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.user-school {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* === 玻璃态统计卡片 === */
.stats-card {
  display: flex;
  align-items: center;
  margin: -40rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
  padding: 32rpx 0;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.12);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
  position: relative;
}

.stat-item:active {
  opacity: 0.7;
}

.stat-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: linear-gradient(90deg, #07c160, #00d97e);
  border-radius: 2rpx;
  opacity: 0;
  transition: opacity 0.2s;
}

.stat-item:active::after {
  opacity: 1;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #f0f0f5;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #07c160, #00d97e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9999aa;
}

/* === 功能菜单 === */
.menu-section {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f5f5fa;
  transition: background 0.2s;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f5fff8;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon-blue { background: linear-gradient(135deg, #4facfe, #00c6fb); }
.icon-red { background: linear-gradient(135deg, #ff6b6b, #ff4d4f); }
.icon-orange { background: linear-gradient(135deg, #ffa751, #ffe259); }
.icon-purple { background: linear-gradient(135deg, #a18cd1, #fbc2eb); }
.icon-green { background: linear-gradient(135deg, #07c160, #00d97e); }
.icon-yellow { background: linear-gradient(135deg, #ffd93d, #ff9a3c); }
.icon-gray { background: linear-gradient(135deg, #b0b0c0, #d0d0e0); }
.icon-cyan { background: linear-gradient(135deg, #43e97b, #38f9d7); }

.menu-icon {
  font-size: 32rpx;
  line-height: 1;
}

.menu-text {
  flex: 1;
  font-size: 29rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cccce0;
  font-weight: 300;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.3);
}

/* === 退出按钮 === */
.logout-btn {
  margin: 48rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff4d4f);
  color: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.3);
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 32rpx;
  width: calc(100% - 64rpx);
}

.logout-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
  animation: shimmer 2.5s infinite;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.25);
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* === 校园生活圈 === */
.plaza-section {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.plaza-header {
  padding: 0 28rpx 20rpx;
}

.plaza-title-row {
  display: flex;
  align-items: center;
}

.plaza-emoji {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.plaza-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-right: 12rpx;
}

.plaza-tag {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
  color: #ff6b35;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.plaza-desc {
  font-size: 24rpx;
  color: #9999aa;
  margin-top: 8rpx;
  display: block;
}

.plaza-scroll {
  white-space: nowrap;
  padding: 0 28rpx;
}

.plaza-card {
  display: inline-flex;
  flex-direction: column;
  width: 240rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  vertical-align: top;
}

.plaza-card:last-child {
  margin-right: 0;
}

.plaza-img {
  width: 100%;
  height: 160rpx;
  background: linear-gradient(135deg, #f0f7f3, #e8f8ef);
}

.plaza-info {
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.plaza-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plaza-tag-line {
  font-size: 22rpx;
  color: #9999aa;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}