/* pages/home/home.wxss */
page {
  background: var(--bg);
}

.page-container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 180rpx;
}

/* === 渐变头部（Stripe 式多色渐变 + 光斑装饰） === */
.home-header {
  position: relative;
  height: 340rpx;
  overflow: hidden;
}

.header-bg-grad {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 12% 20%, rgba(255, 255, 255, 0.22) 0%, transparent 40%),
    radial-gradient(circle at 82% 12%, rgba(var(--warning-rgb), 0.5) 0%, transparent 32%),
    radial-gradient(circle at 88% 8%, rgba(var(--primary-rgb), 0.4) 0%, transparent 45%),
    var(--primary-grad-vivid);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

/* 左上大光斑 */
.home-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  left: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, transparent 70%);
  border-radius: 50%;
}

/* 右下小光斑 */
.home-header::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(var(--primary-rgb), 0.28) 0%, transparent 70%);
  border-radius: 50%;
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 96rpx 40rpx 48rpx;
}

.user-avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.55);
  margin-right: 28rpx;
  background: var(--white);
  box-shadow: 0 8rpx 32rpx rgba(var(--text-rgb), 0.25);
}

/* 头像改由官方 chooseAvatar 按钮承载，点击即弹系统头像选择器 */
.avatar-tap {
  padding: 0;
  margin: 0 28rpx 0 0;
  background: transparent;
  border: none;
  line-height: normal;
  border-radius: 0;
  /* button 默认 overflow:hidden 会裁掉头像投影 */
  overflow: visible;
  display: flex;
  align-items: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.avatar-tap::after {
  border: none;
}

/* 按下有缩放+高亮反馈，杜绝“点了没反应”的观感 */
.avatar-tap:active {
  opacity: 0.85;
  transform: scale(0.94);
}

/* 上传中按钮被 disabled，但样式保持原样（只靠遮罩转圈表达进行中） */
.avatar-tap[disabled] {
  opacity: 1;
  background: transparent;
}

.avatar-box {
  position: relative;
  display: flex;
}

/* 间距交给按钮承担，遮罩才能与头像严格对齐 */
.avatar-box .user-avatar {
  margin-right: 0;
}

/* 字母头像兜底：昵称首字符 + 稳定底色 */
.avatar-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--white);
  font-size: 52rpx;
  font-weight: 600;
}

.avatar-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: var(--white);
  border-radius: 50%;
  animation: avatar-spin 0.8s linear infinite;
}

@keyframes avatar-spin {
  to { transform: rotate(360deg); }
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--white);
  text-shadow: 0 2rpx 12rpx rgba(var(--text-rgb), 0.25);
}

.verify-mini-badge {
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(255, 255, 255, 0.95);
  padding: 5rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(var(--text-rgb), 0.12);
}

.verify-mini-badge.pending {
  color: var(--warning);   /* 状态/提示语义，不是价格 */
}

.menu-verify-badge {
  font-size: 20rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  padding: 5rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 600;
  margin-left: auto;
  margin-right: 12rpx;
}

.menu-verify-badge.pending {
  color: var(--warning-dark);
  background: var(--warning-soft);
}

.menu-verify-badge.unverified {
  color: var(--text-secondary);
  background: var(--fill);
}

.user-school {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.default-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.login-action {
  margin-left: auto;
  padding: 14rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(var(--text-rgb), 0.18);
}

/* === 玻璃态统计卡片 === */
.stats-card {
  display: flex;
  align-items: center;
  margin: -44rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
  padding: 34rpx 0;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(var(--text-rgb), 0.14);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
  position: relative;
}

.stat-item:active {
  opacity: 0.7;
}

.stat-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--primary-grad);
  border-radius: 2rpx;
  opacity: 0;
  transition: opacity 0.2s;
}

.stat-item:active::after {
  opacity: 1;
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: var(--fill);
}

.stat-num {
  font-size: 42rpx;
  font-weight: 800;
  background: var(--primary-grad);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-light);
}

/* === 功能菜单 === */
.menu-section {
  margin: 0 24rpx 24rpx;
  background: var(--white);
  border: 1rpx solid var(--fill);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(var(--text-rgb), 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--bg);
  transition: background 0.2s;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--primary-light);
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(var(--text-rgb), 0.12);
}

/* 菜单图标底色：一律取自令牌，不再每个菜单自带一个色值
   （同一语义共用一个渐变，所以会出现多行同色，这是收敛的结果） */
.icon-blue { background: var(--type-skill-grad); }
.icon-red { background: var(--error-grad); }
.icon-orange { background: var(--price-grad); }
.icon-want { background: var(--type-wanted-grad); }   /* 我的求购 = 求购紫 */
.icon-purple { background: var(--type-wanted-grad); }
.icon-green { background: var(--primary-grad); }
.icon-yellow { background: var(--warning-grad); }
.icon-gray { background: var(--img-ph-grad); }
.icon-cyan { background: var(--primary-grad); }

.menu-icon {
  font-size: 34rpx;
  line-height: 1;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-light);   /* 装饰箭头/图标：统一走「文字弱」，不再各写一种浅灰 */
  font-weight: 300;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  background: var(--error-grad);
  color: var(--white);
  font-size: 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(var(--price-rgb), 0.35);
}

/* === 退出按钮 === */
.logout-btn {
  margin: 48rpx 32rpx 32rpx;
  background: var(--error-grad);
  color: var(--white);
  border-radius: 999rpx;
  height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(var(--price-rgb), 0.25);
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 32rpx;
  width: calc(100% - 64rpx);
}

.logout-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
  animation: shimmer 2.5s infinite;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(var(--price-rgb), 0.2);
}

/* === 校园生活圈 === */
.plaza-section {
  margin: 0 24rpx 24rpx;
  background: var(--white);
  border: 1rpx solid var(--fill);
  border-radius: 32rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 24rpx rgba(var(--text-rgb), 0.05);
}

.plaza-header {
  padding: 0 32rpx 24rpx;
}

.plaza-title-row {
  display: flex;
  align-items: center;
}

.plaza-emoji {
  font-size: 34rpx;
  margin-right: 10rpx;
}

.plaza-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text);
  margin-right: 14rpx;
}

.plaza-tag {
  background: linear-gradient(135deg, var(--warning-soft) 0%, var(--bg) 100%);
  color: var(--price);
  font-size: 22rpx;
  padding: 5rpx 18rpx;
  border-radius: 22rpx;
  font-weight: 600;
}

.plaza-desc {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 10rpx;
  display: block;
}

.plaza-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.plaza-card {
  display: inline-flex;
  flex-direction: column;
  width: 248rpx;
  margin-right: 20rpx;
  background: var(--white);
  border: 1rpx solid var(--fill);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(var(--text-rgb), 0.07);
  vertical-align: top;
  transition: transform 0.2s ease;
}

.plaza-card:active {
  transform: scale(0.97);
}

.plaza-card:last-child {
  margin-right: 0;
}

.plaza-img {
  width: 100%;
  height: 160rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--bg) 100%);
}

.plaza-info {
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.plaza-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plaza-tag-line {
  font-size: 22rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 技能达人 / 评价入口图标 */
.icon-expert { background: var(--type-skill-grad); }
.icon-star { background: var(--warning-grad); }

/* 公益图书角入口图标（占位图，替换 images/bookcorner-entry.png 即可） */
.menu-icon-img {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
}

/* 维护模式横幅 */
.maintenance-banner {
  background: var(--warning-soft);
  padding: 18rpx 28rpx;
  border-bottom: 1rpx solid var(--price-soft);
}

.maintenance-text {
  font-size: 24rpx;
  color: var(--warning);   /* 状态/提示语义，不是价格 */
  line-height: 1.5;
}

/* 批量上架入口图标 */
.icon-batch { background: var(--type-skill-grad); }
