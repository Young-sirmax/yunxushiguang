/* pages/index_register/index_register.wxss */
.register-page {
  padding-top: 40rpx;
}

.register-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.register-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 12rpx;
}

.register-desc {
  font-size: 26rpx;
  color: var(--text-light);
}

.register-form {
  padding: 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: var(--danger);
}

.form-input, .picker-value {
  height: 88rpx;
  line-height: 88rpx;
  background: #f1f5f9;
  border: 2rpx solid transparent;
  border-radius: var(--radius);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  transition: all 0.2s ease;
}

.form-input:focus {
  border-color: var(--primary);
  background: var(--white);
  box-shadow: 0 0 0 6rpx rgba(0, 193, 126, 0.08);
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-value.placeholder {
  color: var(--text-light);
}

.arrow {
  color: var(--text-light);
  font-size: 32rpx;
}

.avatar-item {
  display: flex;
  align-items: center;
}

.avatar-item .form-label {
  margin-bottom: 0;
  width: 160rpx;
  flex-shrink: 0;
}

.avatar-upload {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--text-light);
  transition: all 0.2s ease;
}

.avatar-placeholder:active {
  border-color: var(--primary);
  background: var(--primary-soft);
}

.avatar-icon {
  font-size: 48rpx;
  color: var(--text-light);
}

.error-text {
  display: block;
  font-size: 24rpx;
  color: var(--danger);
  margin-top: 8rpx;
}

.hint-text {
  display: block;
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.privacy-agree {
  display: flex;
  align-items: flex-start;
  margin: 40rpx 0 32rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.privacy-agree checkbox {
  transform: scale(0.7);
  margin-right: 8rpx;
}

.privacy-text {
  line-height: 1.6;
}

.link {
  color: var(--primary);
  font-weight: 500;
}

.submit-btn {
  width: 100%;
}
/* 头像改为微信官方 chooseAvatar 按钮后的样式重置 */
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.avatar-btn::after {
  border: none;
}
.avatar-btn:active {
  opacity: 0.75;
}
