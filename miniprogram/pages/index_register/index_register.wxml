<!--pages/index_register/index_register.wxml-->
<view class="container register-page">
  <view class="register-header">
    <text class="register-title">完善信息</text>
    <text class="register-desc">请填写实名信息，学号将用于人工核验</text>
  </view>

  <view class="register-form card">
    <!-- 头像上传 -->
    <view class="form-item avatar-item">
      <text class="form-label">头像</text>
      <view class="avatar-upload" bindtap="chooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"/>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-icon">+</text>
        </view>
      </view>
    </view>

    <!-- 学校选择 -->
    <view class="form-item">
      <text class="form-label">所在学校 <text class="required">*</text></text>
      <picker mode="selector" range="{{universityList}}" range-key="name" bindchange="onUniversityChange">
        <view class="picker-value {{selectedUniversity ? '' : 'placeholder'}}">
          {{selectedUniversity ? selectedUniversity.name : '请选择学校'}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 姓名 -->
    <view class="form-item">
      <text class="form-label">姓名 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{realName}}" bindinput="onRealNameInput"/>
    </view>

    <!-- 学号 -->
    <view class="form-item">
      <text class="form-label">学号 <text class="required">*</text></text>
      <input class="form-input" type="number" maxlength="10" placeholder="请输入学号（如：2024011251）" value="{{studentId}}" bindinput="onStudentIdInput"/>
      <text class="hint-text">10位数字，前4位为入学年份，供人工核验</text>
      <text wx:if="{{studentIdError}}" class="error-text">{{studentIdError}}</text>
    </view>

    <!-- 昵称 -->
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="对外展示的昵称（选填，默认同姓名）" value="{{nickName}}" bindinput="onNickNameInput"/>
    </view>

    <!-- 联系方式 -->
    <view class="form-item">
      <text class="form-label">联系方式 <text class="required">*</text></text>
      <input class="form-input" placeholder="微信号或手机号（4-30位）" value="{{contact}}" bindinput="onContactInput"/>
      <text wx:if="{{contactError}}" class="error-text">{{contactError}}</text>
    </view>

    <!-- 隐私协议 -->
    <view class="privacy-agree">
      <checkbox checked="{{agreed}}" bindtap="toggleAgree"/>
      <view class="privacy-text">
        我已阅读并同意<text class="link" bindtap="goPrivacy">《隐私政策》</text>
      </view>
    </view>

    <button class="btn-primary submit-btn" bindtap="handleRegister" disabled="{{!canSubmit}}">
      完成注册
    </button>
  </view>
</view>