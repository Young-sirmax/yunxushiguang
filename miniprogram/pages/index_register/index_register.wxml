<!--pages/index_register/index_register.wxml-->
<view class="container register-page">
  <view class="register-header">
    <text class="register-title">完善信息</text>
    <text class="register-desc">填写基本信息即可开始使用，学生认证可在"我的"中完成</text>
  </view>

  <view class="register-form card">
    <!-- 头像上传 -->
    <view class="form-item avatar-item">
      <text class="form-label">头像</text>
      <button class="avatar-upload avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"/>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-icon">+</text>
        </view>
      </button>
    </view>

    <!-- 昵称 -->
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="对外展示的昵称" value="{{nickName}}" bindinput="onNickNameInput"/>
    </view>

    <!-- 手机号（仅用于账号找回，不对外展示） -->
    <view class="form-item">
      <text class="form-label">手机号 <text class="required">*</text></text>
      <input class="form-input" type="number" maxlength="11" placeholder="仅用于账号找回，不对外展示" value="{{phone}}" bindinput="onPhoneInput"/>
      <text wx:if="{{phoneError}}" class="error-text">{{phoneError}}</text>
    </view>

    <!-- 微信号（对外展示，供交易对方复制） -->
    <view class="form-item">
      <text class="form-label">微信号 <text class="required">*</text></text>
      <input class="form-input" placeholder="字母开头，6-20位字母/数字/_-" value="{{wechatId}}" bindinput="onWechatInput"/>
      <text wx:if="{{wechatIdError}}" class="error-text">{{wechatIdError}}</text>
    </view>

    <!-- 二次确认微信号 -->
    <view class="form-item">
      <text class="form-label">确认微信号 <text class="required">*</text></text>
      <input class="form-input" placeholder="请再次输入微信号" value="{{wechatConfirm}}" bindinput="onWechatConfirmInput"/>
      <text wx:if="{{wechatConfirmError}}" class="error-text">{{wechatConfirmError}}</text>
    </view>

    <!-- 隐私协议 -->
    <view class="privacy-agree">
      <checkbox checked="{{agreed}}" bindtap="toggleAgree"/>
      <view class="privacy-text">
        我已阅读并同意<text class="link" bindtap="goPrivacy">《用户协议与隐私政策》</text>
      </view>
    </view>

    <button class="btn-primary submit-btn" bindtap="handleRegister" disabled="{{!canSubmit}}">
      完成注册
    </button>
  </view>
</view>