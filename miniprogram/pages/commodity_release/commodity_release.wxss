/* pages/commodity_release/commodity_release.wxss */
page {
  background: #f5f7fa;
}

.release-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 200rpx;
}

/* === 顶部渐变区 === */
.release-header {
  position: relative;
  height: 220rpx;
  overflow: hidden;
}

.header-bg-grad {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, #07c160 0%, #06ad56 50%, #00b86b 100%);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 40rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.header-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* === 表单主体 === */
.release-body {
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.form-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.card-sub {
  font-size: 24rpx;
  color: #9999aa;
}

.card-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #9999aa;
  line-height: 1.6;
}

/* === 图片上传网格 === */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-cell {
  position: relative;
  width: calc(33.333% - 12rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5fa;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.img-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #07c160, #00d97e);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-icon {
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 300;
}

.add-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d0d0d8;
  background: #fafafa;
}

.add-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-plus {
  font-size: 56rpx;
  color: #b0b0c0;
  line-height: 1;
}

.add-label {
  font-size: 22rpx;
  color: #9999aa;
  margin-top: 8rpx;
}

/* === 表单字段 === */
.field-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5fa;
  min-height: 80rpx;
}

.field-row:last-child {
  border-bottom: none;
}

.field-row.column {
  flex-direction: column;
  align-items: flex-start;
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #555566;
  font-weight: 500;
}

.field-row.column .field-label {
  margin-bottom: 20rpx;
}

.field-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a2e;
}

.field-counter {
  font-size: 22rpx;
  color: #bbb;
  margin-left: 16rpx;
}

.field-picker {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #1a1a2e;
}

.field-picker.placeholder {
  color: #9999aa;
}

.picker-arrow {
  font-size: 32rpx;
  color: #cccce0;
}

/* === 成色芯片 === */
.condition-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: #f5f7fa;
  font-size: 28rpx;
  color: #555566;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.chip.active {
  background: linear-gradient(135deg, #07c160, #00d97e);
  color: #fff;
  font-weight: 500;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.25);
}

/* === 价格输入 === */
.price-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.price-symbol {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff4d4f;
  margin-right: 8rpx;
}

.price-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.discount-tag {
  margin-left: 12rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff4d4f);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.discount-text {
  color: #fff;
}

/* === 数量步进器 === */
.stepper {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 16rpx;
  overflow: hidden;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #555566;
  background: #f0f0f5;
  user-select: none;
}

.step-btn:active {
  background: #e8e8ef;
}

.step-input {
  width: 100rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a2e;
}

/* === 智能定价 === */
.smart-tip {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #e8f8ef, #f0faf3);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.smart-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.smart-body {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  flex: 1;
}

.smart-title {
  font-size: 26rpx;
  color: #555566;
  margin-right: 12rpx;
}

.smart-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff4d4f;
  margin-right: 12rpx;
}

.smart-desc {
  font-size: 22rpx;
  color: #9999aa;
  width: 100%;
  margin-top: 4rpx;
}

/* === 描述区 === */
.desc-area {
  width: 100%;
  height: 280rpx;
  background: #f8f8f8;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1a1a2e;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}

.tag-hint {
  font-size: 24rpx;
  color: #9999aa;
  margin-right: 4rpx;
}

.quick-tag {
  padding: 10rpx 24rpx;
  background: #f0f7f3;
  color: #07c160;
  font-size: 24rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

/* === 安全提示 === */
.safe-tips {
  padding: 16rpx 32rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-dot {
  width: 8rpx;
  height: 8rpx;
  background: #07c160;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #9999aa;
  line-height: 1.6;
}

/* === 底部操作栏 === */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx 40rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-hint {
  text-align: center;
  font-size: 24rpx;
  color: #ff9900;
  margin-bottom: 12rpx;
}

.publish-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160, #00d97e);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  line-height: normal;
}

.publish-btn::after {
  border: none;
}

.publish-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
  animation: shimmer 2.5s infinite;
}

.publish-btn:active {
  transform: scale(0.97);
}

.publish-btn[disabled] {
  background: linear-gradient(135deg, #c8e6d4, #b8e6cc);
  color: rgba(255, 255, 255, 0.85);
  box-shadow: none;
}

.publish-btn[disabled]::before {
  display: none;
}

/* === 模式切换 === */
.mode-switch {
  position: relative;
  z-index: 1;
  display: flex;
  margin: 24rpx 40rpx 0;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 100rpx;
  padding: 8rpx;
}

.mode-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 100rpx;
  transition: all 0.3s ease;
}

.mode-item.active {
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.mode-icon {
  font-size: 32rpx;
}

.mode-label {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.mode-item.active .mode-label {
  color: #07c160;
  font-weight: 600;
}

/* === 信任认证 === */
.auth-status {
  display: flex;
  align-items: center;
}

.status-pill {
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-pill.verified {
  background: linear-gradient(135deg, #07c160, #00d97e);
  color: #fff;
}

.status-pill.unverified {
  background: #f0f7f3;
  color: #07c160;
}

.auth-desc {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #f0faf3, #e8f8ef);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.auth-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.auth-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.auth-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #07c160;
  margin-bottom: 6rpx;
}

.auth-sub {
  font-size: 24rpx;
  color: #555566;
  line-height: 1.5;
}

.auth-advantages {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.adv-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f8f8fa;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
}

.adv-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #07c160;
  margin-bottom: 6rpx;
}

.adv-text {
  font-size: 22rpx;
  color: #9999aa;
  text-align: center;
}

.auth-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid #f5f5fa;
}

.toggle-label {
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.auth-switch {
  transform: scale(0.8);
}

.auth-upload {
  margin-top: 24rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #9999aa;
  margin-bottom: 16rpx;
}

.auth-image-grid {
  display: flex;
  gap: 16rpx;
}

.auth-img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5fa;
}

.auth-img-cell.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #07c160;
  background: #f0faf3;
}

.auth-thumb {
  width: 100%;
  height: 100%;
}

.auth-img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

.auth-add-icon {
  font-size: 48rpx;
  color: #07c160;
  line-height: 1;
}

.auth-add-label {
  font-size: 22rpx;
  color: #07c160;
  margin-top: 8rpx;
}

.auth-privacy {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #aaa;
}

.auth-process {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 0;
}

.process-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.5;
}

.process-step.active,
.process-step.done {
  opacity: 1;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f5;
  color: #999;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.process-step.done .step-dot {
  background: linear-gradient(135deg, #07c160, #00d97e);
  color: #fff;
}

.process-step.active .step-dot {
  background: linear-gradient(135deg, #ff9900, #ffb347);
  color: #fff;
}

.step-text {
  font-size: 22rpx;
  color: #555566;
}

.process-line {
  flex: 1;
  height: 4rpx;
  background: #e8e8ef;
  margin: 0 12rpx;
  margin-bottom: 28rpx;
}

/* === 曝光特权 === */
.privilege-badge {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
  color: #ff6b35;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.privilege-desc {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff8f0, #fff3e0);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.priv-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.priv-text {
  font-size: 26rpx;
  color: #555566;
}

.privilege-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.privilege-item {
  display: flex;
  align-items: flex-start;
  background: #f8f8fa;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.privilege-item.active {
  background: linear-gradient(135deg, #f0faf3, #e8f8ef);
  border-color: #07c160;
}

.priv-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 2rpx solid #e0e0e5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  color: #07c160;
  font-weight: 600;
  flex-shrink: 0;
}

.privilege-item.active .priv-check {
  background: #07c160;
  border-color: #07c160;
  color: #fff;
}

.priv-info {
  flex: 1;
}

.priv-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.priv-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.priv-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b35;
}

.priv-desc {
  font-size: 24rpx;
  color: #9999aa;
  line-height: 1.5;
}

.privilege-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.total-label {
  font-size: 26rpx;
  color: #555566;
}

.total-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6b35;
}

.privilege-guide {
  background: #f8f8fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.guide-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  display: block;
}

.guide-step {
  font-size: 24rpx;
  color: #555566;
  line-height: 1.8;
  display: block;
}

/* === 求购/悬赏 === */
.want-image-hint {
  display: flex;
  align-items: center;
  background: #fff8f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.hint-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #555566;
  line-height: 1.5;
}

.reward-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #f5f5fa;
}

.reward-label {
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.reward-options {
  display: flex;
  gap: 16rpx;
}

.reward-chip {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: #f5f7fa;
  font-size: 26rpx;
  color: #555566;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.reward-chip.active {
  background: linear-gradient(135deg, #ff9900, #ff6b35);
  color: #fff;
  font-weight: 500;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.25);
}

.reward-tip {
  display: flex;
  align-items: center;
  background: #fff8f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #555566;
  line-height: 1.5;
}

.reward-tip.free {
  background: #f0f7f3;
}

.reward-tip .tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.want-publish-fee {
  margin-top: 20rpx;
  background: #f8f8fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fee-label {
  font-size: 26rpx;
  color: #555566;
}

.fee-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff6b35;
}

.fee-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9999aa;
  line-height: 1.5;
}

/* === 底部费用摘要 === */
.cost-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff8f0;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.cost-label {
  font-size: 26rpx;
  color: #555566;
  margin-right: 8rpx;
}

.cost-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b35;
}

.cost-note {
  font-size: 22rpx;
  color: #9999aa;
  margin-left: 8rpx;
}

.free-tag {
