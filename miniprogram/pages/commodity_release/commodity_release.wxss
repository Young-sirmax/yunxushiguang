/* pages/commodity_release/commodity_release.wxss */
page {
  background: var(--bg);
}

.release-page {
  min-height: 100vh;
  background: var(--bg);
  /* 底部固定操作栏高度（约 240rpx）+ 安全区，避免说明文字被遮住 */
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

/* === 顶部渐变区 === */
.release-header {
  position: relative;
  height: 220rpx;
  overflow: hidden;
}

.header-bg-grad {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--primary-grad-vivid);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 40rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.header-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* === 表单主体 === */
.release-body {
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.form-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.card-sub {
  font-size: 24rpx;
  color: var(--text-light);
}

.card-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* === 图片上传网格 === */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-cell {
  position: relative;
  width: calc(33.333% - 12rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--fill);
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.img-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: var(--primary-grad);
  color: var(--white);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}

.img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-icon {
  color: var(--white);
  font-size: 28rpx;
  line-height: 1;
  font-weight: 300;
}

.add-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--fill-strong);
  background: var(--bg);
}

.add-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-plus {
  font-size: 56rpx;
  color: var(--text-light);
  line-height: 1;
}

.add-label {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

/* === 表单字段 === */
.field-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--fill);
  min-height: 80rpx;
}

.field-row:last-child {
  border-bottom: none;
}

.field-row.column {
  flex-direction: column;
  align-items: flex-start;
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.field-row.column .field-label {
  margin-bottom: 20rpx;
}

.field-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}

.field-counter {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 16rpx;
}

.field-picker {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: var(--text);
}

.field-picker.placeholder {
  color: var(--text-light);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--text-light);   /* 装饰箭头/图标：统一走「文字弱」，不再各写一种浅灰 */
}

/* === 成色芯片 === */
.condition-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: var(--bg);
  font-size: 28rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.chip.active {
  background: var(--primary-grad);
  color: var(--white);
  font-weight: 500;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(var(--primary-rgb), 0.25);
}

/* === 价格输入 === */
.price-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.price-symbol {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--price);
  margin-right: 8rpx;
}

.price-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.discount-tag {
  margin-left: 12rpx;
  background: var(--error-grad);
  color: var(--white);
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
}

.discount-text {
  color: var(--white);
}

/* === 数量步进器 === */
.stepper {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 16rpx;
  overflow: hidden;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-secondary);
  background: var(--fill);
  user-select: none;
}

.step-btn:active {
  background: var(--fill);
}

.step-input {
  width: 100rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
}

/* === 智能定价 === */
.smart-tip {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--bg) 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.smart-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.smart-body {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  flex: 1;
}

.smart-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.smart-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--price);
  margin-right: 12rpx;
}

.smart-desc {
  font-size: 22rpx;
  color: var(--text-light);
  width: 100%;
  margin-top: 4rpx;
}

/* === 描述区 === */
.desc-area {
  width: 100%;
  height: 280rpx;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text);
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}

.tag-hint {
  font-size: 24rpx;
  color: var(--text-light);
  margin-right: 4rpx;
}

.quick-tag {
  padding: 10rpx 24rpx;
  background: var(--primary-light);
  color: var(--primary-dark);
  font-size: 24rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}

/* === 安全提示 === */
.safe-tips {
  padding: 16rpx 32rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-dot {
  width: 8rpx;
  height: 8rpx;
  background: var(--primary);
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* === 底部操作栏 === */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--white);
  padding: 20rpx 32rpx 40rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--price);
  margin-bottom: 12rpx;
}

.publish-btn {
  width: 100%;
  height: 96rpx;
  background: var(--primary-grad);
  color: var(--white);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(var(--primary-rgb), 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  line-height: normal;
}

.publish-btn::after {
  border: none;
}

.publish-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
  animation: shimmer 2.5s infinite;
}

.publish-btn:active {
  transform: scale(0.97);
}

.publish-btn[disabled] {
  background: linear-gradient(135deg, var(--fill-strong) 0%, var(--fill) 100%);
  color: var(--text-light);
  box-shadow: none;
}

.publish-btn[disabled]::before {
  display: none;
}

/* === 模式切换 === */
.mode-switch {
  position: relative;
  z-index: 1;
  display: flex;
  margin: 24rpx 40rpx 0;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 100rpx;
  padding: 8rpx;
}

.mode-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 100rpx;
  transition: all 0.3s ease;
}

.mode-item.active {
  background: var(--white);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.mode-icon {
  font-size: 32rpx;
}

.mode-label {
  font-size: 28rpx;
  color: var(--white);
  font-weight: 500;
}

.mode-item.active .mode-label {
  color: var(--primary);
  font-weight: 600;
}

.mode-item.want.active .mode-label {
  color: var(--type-wanted-text);
}

/* 求购模式下主按钮使用青蓝渐变，强化“求购”心智 */
.publish-btn.want {
  background: var(--type-wanted-grad);
  box-shadow: 0 8rpx 28rpx rgba(var(--type-wanted-rgb), 0.3);
}

.publish-btn.want[disabled] {
  background: linear-gradient(135deg, var(--type-idle-soft) 0%, var(--bg) 100%);
  box-shadow: none;
}

/* === 曝光特权 === */
.privilege-badge {
  background: linear-gradient(135deg, var(--warning-soft) 0%, var(--bg) 100%);
  color: var(--price);
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.privilege-desc {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--warning-soft) 0%, var(--bg) 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.priv-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.priv-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.privilege-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.privilege-item {
  display: flex;
  align-items: flex-start;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.privilege-item.active {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--bg) 100%);
  border-color: var(--primary);
}

.priv-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--white);
  border: 2rpx solid var(--fill-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  color: var(--primary);
  font-weight: 600;
  flex-shrink: 0;
}

.privilege-item.active .priv-check {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--white);
}

.priv-info {
  flex: 1;
}

.priv-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.priv-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.priv-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--price);
}

.priv-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.privilege-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, var(--warning-soft) 0%, var(--bg) 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.total-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.total-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--price);
}

.privilege-guide {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.guide-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  display: block;
}

.guide-step {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  display: block;
}

/* === 求购/悬赏 === */
.want-image-hint {
  display: flex;
  align-items: center;
  background: var(--price-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.hint-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.reward-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--fill);
}

.reward-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.reward-options {
  display: flex;
  gap: 16rpx;
}

.reward-chip {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: var(--bg);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.reward-chip.active {
  background: var(--price-grad);
  color: var(--white);
  font-weight: 500;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(var(--price-rgb), 0.25);
}

.reward-tip {
  display: flex;
  align-items: center;
  background: var(--price-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.reward-tip.free {
  background: var(--primary-light);
}

.reward-tip .tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.want-publish-fee {
  margin-top: 20rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fee-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.fee-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--price);
}

.fee-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.5;
}

/* === 底部费用摘要 === */
.cost-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--price-soft);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.cost-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.cost-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--price);
}

.cost-note {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 8rpx;
}

.free-tag {
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 12rpx;
  font-weight: 500;
}
/* === 图书专区：适用专业（多选） === */
.field-optional {
  font-size: 22rpx;
  color: var(--text-light);
  font-weight: 400;
}

.major-picker {
  width: 100%;
}

.major-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.major-line-label {
  flex-shrink: 0;
  width: 72rpx;
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 56rpx;
}

.major-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.major-row {
  display: flex;
}

.major-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg);
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  flex-shrink: 0;
  white-space: nowrap;
}

.major-chip.active {
  background: var(--primary-light);
  color: var(--primary-dark);
  border-color: var(--primary-dark);
  font-weight: 600;
}

/* 专业行用青蓝区分层级 */
.major-chip.major.active {
  background: var(--type-wanted-soft);
  color: var(--type-wanted-text);
  border-color: var(--type-wanted-text);
}

.major-selected {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}

.major-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  font-size: 23rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border-radius: 40rpx;
}

.major-tag-x {
  margin-left: 10rpx;
  font-size: 26rpx;
  line-height: 1;
  opacity: 0.7;
}

.major-tip {
  font-size: 23rpx;
  color: var(--text-light);
  line-height: 1.6;
  margin-top: 4rpx;
}

/* === 以物易物：类型高亮 / 只读联系方式 === */
.mode-item.exchange.active .mode-label {
  color: var(--type-exchange-text);
}

.publish-btn.exchange {
  background: var(--type-exchange-grad);
  box-shadow: 0 8rpx 28rpx rgba(var(--type-exchange-rgb), 0.34);
}

.publish-btn.exchange[disabled] {
  background: linear-gradient(135deg, var(--type-exchange-soft) 0%, var(--bg) 100%);
  box-shadow: none;
}

.contact-readonly {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  word-break: break-all;
}

.contact-readonly.empty {
  font-size: 26rpx;
  color: var(--warning);   /* 状态/提示语义，不是价格 */;
}

/* === 技能服务：类型高亮 / 发布按钮 === */
.mode-item.skill.active .mode-label {
  color: var(--type-skill-text);
}

.publish-btn.skill {
  background: var(--type-skill-grad);
  box-shadow: 0 8rpx 28rpx rgba(var(--type-skill-rgb), 0.36);
}

.publish-btn.skill[disabled] {
  background: linear-gradient(135deg, var(--type-skill-soft) 0%, var(--bg) 100%);
  box-shadow: none;
}

/* 技能参考价提示（灰色引导文案） */
.price-ref-tip {
  padding: 4rpx 0 16rpx 160rpx;
  font-size: 23rpx;
  color: var(--text-light);
  line-height: 1.5;
}

/* === 缩略图生成用的离屏画布：移出可视区域，避免影响布局 === */
.thumb-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 320px;
  height: 320px;
  pointer-events: none;
  opacity: 0;
}

/* === 求购分区：物品求购 / 技能求助（紫系深浅区分） === */
.field-required {
  color: var(--error);
  font-size: 28rpx;
  margin-left: 6rpx;
}

.want-seg {
  display: flex;
  gap: 20rpx;
}

.want-seg-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  border-radius: 24rpx;
  background: var(--bg);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.want-seg-item .ws-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.want-seg-item .ws-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.want-seg-item.goods.active {
  background: var(--type-wanted-grad);
  box-shadow: 0 8rpx 22rpx rgba(var(--type-wanted-rgb), 0.3);
}

.want-seg-item.skill.active {
  background: var(--type-wanted-deep-grad);
  box-shadow: 0 8rpx 22rpx rgba(var(--type-wanted-rgb), 0.3);
}

.want-seg-item.active .ws-label {
  color: var(--white);
  font-weight: 600;
}

.want-seg-hint {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.6;
}
