<!--pages/commodity_release/commodity_release.wxml-->
<view class="release-page">
  <!-- 顶部渐变头区 -->
  <view class="release-header">
    <view class="header-bg-grad"></view>
    <view class="header-content">
      <view class="header-title">{{isEdit ? '编辑信息' : '发布信息'}}</view>
      <view class="header-tip">{{isEdit ? '修改信息内容' : '免费发布，精准触达'}}</view>
    </view>
    <!-- 类型选择：闲置转让 / 求购 / 以物易物 -->
    <view class="mode-switch">
      <view class="mode-item {{mode === 'sell' ? 'active' : ''}}" bindtap="switchMode" data-mode="sell">
        <text class="mode-icon">📦</text>
        <text class="mode-label">闲置转让</text>
      </view>
      <view class="mode-item want {{mode === 'want' ? 'active' : ''}}" bindtap="switchMode" data-mode="want">
        <text class="mode-icon">🔍</text>
        <text class="mode-label">求购</text>
      </view>
      <view class="mode-item exchange {{mode === 'exchange' ? 'active' : ''}}" bindtap="switchMode" data-mode="exchange">
        <text class="mode-icon">🔁</text>
        <text class="mode-label">以物易物</text>
      </view>
      <view class="mode-item skill {{mode === 'skill' ? 'active' : ''}}" bindtap="switchMode" data-mode="skill">
        <text class="mode-icon">🎓</text>
        <text class="mode-label">技能服务</text>
      </view>
    </view>
  </view>

  <!-- 表单主体 -->
  <view class="release-body">

    <!-- 求购分区：物品求购 / 技能求助（必选，未选不能提交） -->
    <view class="form-card want-seg-card" wx:if="{{mode === 'want'}}">
      <view class="card-head">
        <text class="card-title">求购类型<text class="field-required">*</text></text>
        <text class="card-sub">{{wantCategory ? '' : '请先选择'}}</text>
      </view>
      <view class="want-seg">
        <view
          class="want-seg-item goods {{wantCategory === 'goods' ? 'active' : ''}}"
          data-value="goods"
          bindtap="onWantCategoryTap"
        >
          <text class="ws-icon">📦</text>
          <text class="ws-label">物品求购</text>
        </view>
        <view
          class="want-seg-item skill {{wantCategory === 'skill' ? 'active' : ''}}"
          data-value="skill"
          bindtap="onWantCategoryTap"
        >
          <text class="ws-icon">🎓</text>
          <text class="ws-label">技能求助</text>
        </view>
      </view>
      <view class="want-seg-hint">{{wantCategory === 'skill' ? '想找人帮忙 / 找同学提供服务，选「技能求助」' : (wantCategory === 'goods' ? '想收实物闲置物品，选「物品求购」' : '请选择：收实物选「物品求购」，找人帮忙选「技能求助」')}}</view>
    </view>

    <!-- 图片上传区（闲置转让 / 以物易物 / 技能服务） -->
    <view class="form-card" wx:if="{{mode !== 'want'}}">
      <view class="card-head">
        <text class="card-title">{{mode === 'skill' ? '作品 / 服务图片' : '商品图片'}}</text>
        <text class="card-sub">已添加 {{images.length}} 张</text>
      </view>
      <view class="image-grid">
        <view class="image-cell" wx:for="{{images}}" wx:key="index" wx:for-item="img" wx:for-index="idx">
          <image src="{{img}}" mode="aspectFill" class="thumb-img" bindtap="previewImage" data-index="{{idx}}"/>
          <view class="img-badge" wx:if="{{idx === 0}}">主图</view>
          <view class="img-del" catchtap="deleteImage" data-index="{{idx}}">
            <text class="del-icon">×</text>
          </view>
        </view>
        <view class="image-cell add-cell" bindtap="chooseImage">
          <view class="add-inner">
            <text class="add-plus">+</text>
            <text class="add-label">添加图片</text>
          </view>
        </view>
      </view>
      <view class="card-hint">支持从相册或相机选择，建议上传 3 张以上以提高曝光</view>
    </view>

    <!-- 求购图片（可选） -->
    <view class="form-card" wx:if="{{mode === 'want'}}">
      <view class="card-head">
        <text class="card-title">参考图片（可选）</text>
      </view>
      <view class="want-image-hint">
        <text class="hint-icon">💡</text>
        <text class="hint-text">{{wantCategory === 'skill' ? '可上传作品 / 服务参考图，帮助对方了解你的需求' : '可上传想要的物品参考图，帮助对方快速了解'}}</text>
      </view>
      <view class="image-grid">
        <view class="image-cell" wx:for="{{images}}" wx:key="index" wx:for-item="img" wx:for-index="idx">
          <image src="{{img}}" mode="aspectFill" class="thumb-img" bindtap="previewImage" data-index="{{idx}}"/>
          <view class="img-del" catchtap="deleteImage" data-index="{{idx}}">
            <text class="del-icon">×</text>
          </view>
        </view>
        <view class="image-cell add-cell" bindtap="chooseImage">
          <view class="add-inner">
            <text class="add-plus">+</text>
            <text class="add-label">添加图片</text>
          </view>
        </view>
      </view>
      <view class="fee-tip">💡 所有信息免费发布，不收取任何费用</view>
    </view>

    <!-- 基本信息 -->
    <view class="form-card">
      <view class="card-head">
        <text class="card-title">{{mode === 'sell' ? '基本信息' : (mode === 'want' ? '求购信息' : (mode === 'skill' ? '服务信息' : '易物信息'))}}</text>
      </view>

      <!-- 标题 -->
      <view class="field-row">
        <text class="field-label">{{mode === 'want' ? '想要' : '标题'}}</text>
        <view class="field-input-wrap">
          <input class="field-input" placeholder="{{mode === 'want' ? '描述你想找的物品' : '简明扼要，让人一眼动心'}}" value="{{title}}" bindinput="onTitleInput" maxlength="30"/>
          <text class="field-counter">{{title.length}}/30</text>
        </view>
      </view>

      <!-- 分类选择：求购 + 技能求助时列出技能分类，其余列出物品分类 -->
      <view class="field-row">
        <text class="field-label">{{mode === 'want' && wantCategory === 'skill' ? '技能分类' : '分类'}}</text>
        <picker mode="selector" range="{{pickerRange}}" range-key="name" bindchange="onCategoryChange">
          <view class="field-picker {{(mode === 'want' && wantCategory === 'skill') ? (wantSkillCategory ? '' : 'placeholder') : (selectedCategory ? '' : 'placeholder')}}">
            <text wx:if="{{mode === 'want' && wantCategory === 'skill'}}">{{wantSkillCategory || '选择技能分类'}}</text>
            <text wx:else>{{selectedCategory ? selectedCategory.name : '选择分类'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <!-- 图书专区：适用专业（可多选，非必填） -->
      <view class="field-row column" wx:if="{{isBookCategory}}">
        <text class="field-label">适用专业<text class="field-optional">（可多选）</text></text>
        <view class="major-picker">
          <view class="major-line">
            <text class="major-line-label">学院</text>
            <scroll-view class="major-scroll" scroll-x enhanced show-scrollbar="{{false}}">
              <view class="major-row">
                <view
                  class="major-chip {{currentCollege === item ? 'active' : ''}}"
                  wx:for="{{collegeList}}"
                  wx:key="*this"
                  data-college="{{item}}"
                  bindtap="selectBookCollege"
                >{{item}}</view>
              </view>
            </scroll-view>
          </view>

          <view class="major-line" wx:if="{{currentCollege}}">
            <text class="major-line-label">专业</text>
            <scroll-view class="major-scroll" scroll-x enhanced show-scrollbar="{{false}}">
              <view class="major-row">
                <view
                  class="major-chip major {{item.checked ? 'active' : ''}}"
                  wx:for="{{majorOptions}}"
                  wx:key="name"
                  data-major="{{item.name}}"
                  bindtap="toggleMajor"
                >{{item.name}}</view>
              </view>
            </scroll-view>
          </view>

          <view class="major-selected" wx:if="{{selectedMajors.length > 0}}">
            <view
              class="major-tag"
              wx:for="{{selectedMajors}}"
              wx:key="*this"
              data-major="{{item}}"
              bindtap="removeMajor"
            >{{item}}<text class="major-tag-x">×</text></view>
          </view>
          <view class="major-tip" wx:else>选填：选好后，买家可按专业筛选和搜索到这本书</view>
        </view>
      </view>

      <!-- 成色/需求 -->
      <view class="field-row column" wx:if="{{mode === 'sell' || mode === 'exchange'}}">
        <text class="field-label">成色<text class="field-optional">（选填）</text></text>
        <view class="condition-chips">
          <view 
            class="chip {{condition === item ? 'active' : ''}}" 
            wx:for="{{conditionOptions}}" 
            wx:key="*this"
            bindtap="onConditionTap"
            data-value="{{item}}"
          >{{item}}</view>
        </view>
      </view>

      <view class="field-row column" wx:if="{{mode === 'want'}}">
        <text class="field-label">需求成色</text>
        <view class="condition-chips">
          <view 
            class="chip {{condition === item ? 'active' : ''}}" 
            wx:for="{{conditionOptions}}" 
            wx:key="*this"
            bindtap="onConditionTap"
            data-value="{{item}}"
          >{{item}}</view>
        </view>
      </view>

      <!-- 交易地点 / 取货地 -->
      <view class="field-row">
        <text class="field-label">{{mode === 'sell' ? '取货地' : '交易地点'}}</text>
        <view class="field-input-wrap">
          <input class="field-input" placeholder="如：3号宿舍楼 / 东区食堂" value="{{tradeLocation}}" bindinput="onLocationInput"/>
        </view>
      </view>

      <!-- 联系方式：统一使用账号微信号（只读，可在「个人信息」修改） -->
      <view class="field-row">
        <text class="field-label">联系方式</text>
        <view class="field-input-wrap">
          <text class="contact-readonly {{wechatId ? '' : 'empty'}}">{{wechatId || '未填写微信号，请先到「个人信息」完善'}}</text>
        </view>
      </view>
    </view>

    <!-- 技能服务：报价模式 + 金额 + 可服务时间 -->
    <view class="form-card" wx:if="{{mode === 'skill'}}">
      <view class="card-head">
        <text class="card-title">服务报价</text>
        <text class="card-sub">面议可不填金额</text>
      </view>

      <view class="field-row">
        <text class="field-label">技能分类</text>
        <picker mode="selector" range="{{skillOptions}}" value="{{skillIndex}}" bindchange="onSkillChange">
          <view class="field-picker {{skillIndex > -1 ? '' : 'placeholder'}}">
            <text>{{skillIndex > -1 ? skillOptions[skillIndex] : '选择技能分类（选填）'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field-row">
        <text class="field-label">报价模式</text>
        <picker mode="selector" range="{{priceUnits}}" range-key="label" value="{{priceUnitIndex}}" bindchange="onPriceUnitChange">
          <view class="field-picker">
            <text>{{priceUnits[priceUnitIndex].label}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field-row" wx:if="{{priceUnit !== 'negotiable'}}">
        <text class="field-label">金额（元）</text>
        <view class="price-wrap">
          <text class="price-symbol">¥</text>
          <input class="price-input" type="digit" placeholder="0.00" value="{{price}}" bindinput="onPriceInput"/>
        </view>
      </view>

      <!-- 该类目参考价（仅提示，不做校验与拦截） -->
      <view class="price-ref-tip" wx:if="{{priceRefText}}">{{priceRefText}}</view>

      <view class="field-row">
        <text class="field-label">可服务时间</text>
        <view class="field-input-wrap">
          <input class="field-input" placeholder="如：周末 / 工作日晚（选填）" value="{{availableTime}}" bindinput="onAvailableTimeInput" maxlength="60"/>
        </view>
      </view>

      <view class="card-hint" wx:if="{{!isExpert}}">⚠️ 你还没有完成技能达人入驻，发布前会引导你去申请</view>
    </view>

    <!-- 以物易物：期望交换物品 + 可接受补差价 -->
    <view class="form-card" wx:if="{{mode === 'exchange'}}">
      <view class="card-head">
        <text class="card-title">交换需求</text>
        <text class="card-sub">期望交换物品必填</text>
      </view>

      <view class="field-row column">
        <text class="field-label">期望交换物品</text>
        <view class="field-input-wrap">
          <input
            class="field-input"
            placeholder="想换什么？如：高数教材、蓝牙耳机、台灯"
            value="{{exchangeWant}}"
            bindinput="onExchangeWantInput"
            maxlength="60"
          />
          <text class="field-counter">{{exchangeWant.length}}/60</text>
        </view>
        <view class="tag-group">
          <text class="tag-hint">常用标签：</text>
          <view
            class="quick-tag"
            wx:for="{{exchangeTags}}"
            wx:key="*this"
            data-tag="{{item}}"
            bindtap="appendExchangeTag"
          >{{item}}</view>
        </view>
      </view>

      <view class="field-row">
        <text class="field-label">补差价</text>
        <view class="price-wrap">
          <text class="price-symbol">¥</text>
          <input
            class="price-input"
            type="digit"
            placeholder="选填"
            value="{{priceDiff}}"
            bindinput="onPriceDiffInput"
          />
        </view>
      </view>
      <view class="card-hint">选填：对方物品价值不足时，你可接受的补差价金额（元）</view>
    </view>

    <!-- 价格参考（仅发布闲置模式） -->
    <view class="form-card" wx:if="{{mode === 'sell'}}">
      <view class="card-head">
        <text class="card-title">价格参考</text>
        <text class="card-sub">仅供参考，实际价格买卖双方线下协商</text>
      </view>

      <!-- 期望价格 -->
      <view class="field-row">
        <text class="field-label">期望价格</text>
        <view class="price-wrap">
          <text class="price-symbol">¥</text>
          <input class="price-input" type="digit" placeholder="0.00" value="{{price}}" bindinput="onPriceInput"/>
        </view>
      </view>

      <!-- 参考原价 -->
      <view class="field-row">
        <text class="field-label">参考原价</text>
        <view class="price-wrap">
          <text class="price-symbol">¥</text>
          <input class="price-input" type="digit" placeholder="选填" value="{{originalPrice}}" bindinput="onOriginalPriceInput"/>
          <view class="discount-tag" wx:if="{{price && originalPrice}}">
            <text class="discount-text">{{discountText}}折</text>
          </view>
        </view>
      </view>

      <!-- 数量 -->
      <view class="field-row">
        <text class="field-label">数量</text>
        <view class="stepper">
          <view class="step-btn" bindtap="decreaseQty">−</view>
          <input class="step-input" type="number" value="{{quantity}}" bindinput="onQuantityInput"/>
          <view class="step-btn" bindtap="increaseQty">+</view>
        </view>
      </view>

      <!-- 智能定价参考 -->
      <view class="smart-tip" wx:if="{{suggestedPrice}}">
        <view class="smart-icon">💡</view>
        <view class="smart-body">
          <text class="smart-title">智能定价参考</text>
          <text class="smart-value">¥{{suggestedPrice}}</text>
          <text class="smart-desc">仅供参考，实际价格请买卖双方线下协商</text>
        </view>
      </view>
    </view>

    <!-- 商品描述 -->
    <view class="form-card">
      <view class="card-head">
        <text class="card-title">{{mode === 'sell' ? '商品描述' : (mode === 'want' ? '需求描述' : (mode === 'skill' ? '服务描述' : '物品描述'))}}</text>
        <text class="card-sub">{{description.length}}/500</text>
      </view>
      <textarea 
        class="desc-area"
        placeholder="{{mode === 'want' ? '详细描述你想要的物品、预算、成色要求等...' : '详细描述品牌、型号、入手时间、使用情况、成色等信息...'}}"
        value="{{description}}"
        bindinput="onDescInput"
        maxlength="500"
      />
      <!-- 快捷标签 -->
      <view class="tag-group" wx:if="{{description.length < 10}}">
        <text class="tag-hint">快速添加：</text>
        <block wx:if="{{mode === 'sell' || mode === 'exchange'}}">
          <view class="quick-tag" bindtap="appendDesc" data-text="全新未拆封">全新</view>
          <view class="quick-tag" bindtap="appendDesc" data-text="仅使用几次">几乎全新</view>
          <view class="quick-tag" bindtap="appendDesc" data-text="原价买入">有入手记录</view>
          <view class="quick-tag" bindtap="appendDesc" data-text="包邮">包邮</view>
        </block>
        <block wx:if="{{mode === 'want'}}">
          <view class="quick-tag" bindtap="appendDesc" data-text="诚心收">诚心收</view>
          <view class="quick-tag" bindtap="appendDesc" data-text="预算可面议">预算可面议</view>
          <view class="quick-tag" bindtap="appendDesc" data-text="见面交易">见面交易</view>
          <view class="quick-tag" bindtap="appendDesc" data-text="长期收">长期收</view>
        </block>
      </view>
    </view>

    <!-- 安全提示 -->
    <view class="safe-tips">
      <view class="tip-item">
        <text class="tip-dot"></text>
        <text class="tip-text">建议当面交易，保障双方权益</text>
      </view>
      <view class="tip-item">
        <text class="tip-dot"></text>
        <text class="tip-text">如实描述，减少交易纠纷</text>
      </view>
      <view class="tip-item">
        <text class="tip-dot"></text>
        <text class="tip-text">本平台为信息展示平台，不参与交易</text>
      </view>
    </view>
  </view>

  <!-- 底部发布按钮 -->
  <view class="bottom-action safe-bottom">
    <view class="action-hint" wx:if="{{!canSubmit}}">
      {{mode === 'sell' ? '请填写有效的价格' : (mode === 'exchange' ? '请填写期望交换的物品' : '至少填写一项信息即可发布')}}
    </view>
    <button
      class="publish-btn {{mode === 'want' ? 'want' : (mode === 'exchange' ? 'exchange' : (mode === 'skill' ? 'skill' : ''))}}"
      bindtap="submitForm"
      disabled="{{!canSubmit || isSubmitting}}"
    >
      <text wx:if="{{isSubmitting}}">发布中...</text>
      <text wx:elif="{{isEdit}}">保存修改</text>
      <text wx:elif="{{mode === 'want'}}">发布求购</text>
      <text wx:elif="{{mode === 'skill'}}">发布服务</text>
      <text wx:elif="{{mode === 'exchange'}}">发布易物</text>
      <text wx:else>立即发布</text>
    </button>
    <view class="free-tag">✓ 免费发布 · 不收取任何费用</view>
  </view>

  <!-- 缩略图生成用的离屏画布：不可见、不参与布局，仅用于导出列表/气泡用的小图 -->
  <canvas type="2d" id="thumbCanvas" class="thumb-canvas"></canvas>
</view>