<!--pages/chat/chat.wxml-->
<view class="chat-container">
  <view class="chat-loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <scroll-view 
    class="chat-scroll" 
    scroll-y 
    scroll-into-view="{{scrollToId}}" 
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="msg-row" id="msg-product">
      <view class="msg-product-card" bindtap="viewProduct">
        <image class="product-thumb" src="{{productInfo.image || '/images/default-goods.png'}}" mode="aspectFill"/>
        <view class="product-info">
          <text class="product-title">{{productInfo.title}}</text>
          <text class="product-price">¥{{productInfo.price}}</text>
        </view>
        <view class="product-arrow">›</view>
      </view>
    </view>

    <view class="chat-empty" wx:if="{{messages.length === 0 && !loading}}">
      <text class="empty-icon">💭</text>
      <text class="empty-text">暂无消息，开始聊天吧</text>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <view class="time-divider" wx:if="{{item.isTimeDivider}}" id="msg-{{item.id}}">
        <text>{{item.text}}</text>
      </view>

      <view class="msg-row self image-row" wx:elif="{{item.isSelf && item.type === 'image'}}" id="msg-{{item.id}}">
        <image class="avatar self-avatar" src="{{userAvatar || '/images/default-avatar.png'}}"/>
        <image class="msg-image" src="{{item.imageUrl}}" mode="widthFix" bindtap="previewImage" data-url="{{item.imageUrl}}"/>
      </view>

      <view class="msg-row self paycode-row" wx:elif="{{item.isSelf && item.type === 'paycode'}}" id="msg-{{item.id}}">
        <view class="paycode-card self-paycode" bindtap="previewPayCode" data-url="{{item.payCodeUrl}}">
          <image class="paycode-img" src="{{item.payCodeUrl}}" mode="aspectFit"/>
          <text class="paycode-label">收款码</text>
        </view>
        <image class="avatar self-avatar" src="{{userAvatar || '/images/default-avatar.png'}}"/>
      </view>

      <view class="msg-row self" wx:elif="{{item.isSelf && item.type === 'text'}}" id="msg-{{item.id}}">
        <view class="bubble self-bubble">
          <text class="bubble-text">{{item.text}}</text>
        </view>
        <image class="avatar self-avatar" src="{{userAvatar || '/images/default-avatar.png'}}"/>
      </view>

      <view class="msg-row other image-row" wx:elif="{{!item.isSelf && item.type === 'image'}}" id="msg-{{item.id}}">
        <image class="avatar other-avatar" src="{{sellerAvatar || '/images/default-avatar.png'}}"/>
        <image class="msg-image" src="{{item.imageUrl}}" mode="widthFix" bindtap="previewImage" data-url="{{item.imageUrl}}"/>
      </view>

      <view class="msg-row other paycode-row" wx:elif="{{!item.isSelf && item.type === 'paycode'}}" id="msg-{{item.id}}">
        <image class="avatar other-avatar" src="{{sellerAvatar || '/images/default-avatar.png'}}"/>
        <view class="paycode-card other-paycode" bindtap="previewPayCode" data-url="{{item.payCodeUrl}}">
          <image class="paycode-img" src="{{item.payCodeUrl}}" mode="aspectFit"/>
          <text class="paycode-label">收款码</text>
        </view>
      </view>

      <view class="msg-row other" wx:elif="{{!item.isSelf && item.type === 'text'}}" id="msg-{{item.id}}">
        <image class="avatar other-avatar" src="{{sellerAvatar || '/images/default-avatar.png'}}"/>
        <view class="bubble other-bubble">
          <text class="bubble-text">{{item.text}}</text>
        </view>
      </view>
    </block>

    <view class="chat-bottom-placeholder"></view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar safe-bottom">
    <!-- 快捷收款操作 -->
    <view class="quick-actions">
      <view class="quick-btn pay-btn" wx:if="{{isOwner}}" bindtap="showPayCode">
        <text class="quick-icon">收</text>
        <text class="quick-text">出示收款码</text>
      </view>
      <view class="quick-btn ask-btn" wx:else bindtap="requestPayCode">
        <text class="quick-icon">金</text>
        <text class="quick-text">索要收款码</text>
      </view>
    </view>

    <view class="input-wrap">
      <view class="icon-btn" bindtap="toggleVoice">
        <text class="icon-text">{{isVoiceMode ? '⌨' : '☎'}}</text>
      </view>
      <input 
        class="msg-input" 
        wx:if="{{!isVoiceMode}}"
        value="{{inputText}}" 
        bindinput="onInput" 
        confirm-type="send"
        bindconfirm="sendMessage"
        placeholder="说点什么..." 
        placeholder-class="input-placeholder"
      />
      <view class="voice-btn" wx:if="{{isVoiceMode}}" bindtap="onVoiceTap">
        <text>按住 说话</text>
      </view>
      <view class="icon-btn" bindtap="toggleEmoji">
        <text class="icon-text">☺</text>
      </view>
      <view class="icon-btn" bindtap="toggleMore">
        <text class="icon-text">＋</text>
      </view>
    </view>
    <button 
      class="send-btn {{inputText ? 'active' : ''}}" 
      wx:if="{{inputText}}" 
      bindtap="sendMessage"
    >发送</button>
  </view>

  <!-- 更多面板 -->
  <view class="more-panel" wx:if="{{showMore}}">
    <view class="more-grid">
      <view class="more-item" bindtap="sendImage">
        <view class="more-icon-text">🖼️</view>
        <text class="more-label">相册</text>
      </view>
      <view class="more-item" bindtap="takePhoto">
        <view class="more-icon-text">📷</view>
        <text class="more-label">拍摄</text>
      </view>
      <view class="more-item" bindtap="sendContact">
        <view class="more-icon-text">📍</view>
        <text class="more-label">位置</text>
      </view>
      <view class="more-item" bindtap="copyContact">
        <view class="more-icon-text">👤</view>
        <text class="more-label">名片</text>
      </view>
    </view>
  </view>

  <!-- 表情面板 -->
  <view class="emoji-panel" wx:if="{{showEmoji}}">
    <view class="emoji-grid">
      <view 
        class="emoji-item" 
        wx:for="{{emojiList}}" 
        wx:key="*this" 
        bindtap="insertEmoji"
        data-emoji="{{item}}"
      >{{item}}</view>
    </view>
  </view>
</view>