/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ededed;
  position: relative;
}

/* 消息滚动区 */
.chat-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx 0;
}

.chat-bottom-placeholder {
  height: 20rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 24rpx;
}

.msg-row.self {
  justify-content: flex-end;
}

/* 时间分隔 */
.time-divider {
  text-align: center;
  padding: 24rpx 0 12rpx;
}

.time-divider text {
  font-size: 22rpx;
  color: #999;
  background: rgba(0, 0, 0, 0.08);
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

/* 商品卡片 */
.msg-product-card {
  width: 420rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.product-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.product-info {
  flex: 1;
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.product-title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  margin-bottom: 12rpx;
}

.product-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.product-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #dcdcdc;
}

.self-avatar {
}

.other-avatar {
  margin-right: 16rpx;
}

/* 气泡 */
.bubble {
  max-width: 480rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  position: relative;
  word-break: break-all;
}

.self-bubble {
  background: #95ec69;
  margin-right: 16rpx;
}

.self-bubble::after {
  content: '';
  position: absolute;
  top: 24rpx;
  right: -12rpx;
  border: 12rpx solid transparent;
  border-left-color: #95ec69;
  border-right: 0;
}

.other-bubble {
  background: #fff;
}

.other-bubble::after {
  content: '';
  position: absolute;
  top: 24rpx;
  left: -12rpx;
  border: 12rpx solid transparent;
  border-right-color: #fff;
  border-left: 0;
}

.bubble-text {
  font-size: 30rpx;
  color: #000;
  line-height: 1.5;
}

/* 底部输入栏 */
.input-bar {
  position: relative;
  z-index: 10;
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  padding: 12rpx 16rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 8rpx;
  height: 80rpx;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-btn .iconfont {
  font-size: 44rpx;
  color: #555;
}

.icon-btn .icon-text {
  font-size: 40rpx;
  color: #555;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  font-size: 30rpx;
  color: #333;
  padding: 0 16rpx;
}

.input-placeholder {
  color: #bbb;
  font-size: 30rpx;
}

.voice-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
  background: #f2f2f2;
  border-radius: 8rpx;
  margin: 0 8rpx;
}

.send-btn {
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  height: 64rpx;
  padding: 0 32rpx;
  margin-left: 16rpx;
  line-height: 64rpx;
}

.send-btn::after {
  border: none;
}

.send-btn.active {
  background: #06ad56;
}

/* 更多面板 */
.more-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 104rpx;
  background: #f7f7f7;
  padding: 32rpx 0;
  border-top: 1rpx solid #e5e5e5;
  z-index: 20;
}

.more-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}

.more-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.more-icon {
  width: 100rpx;
  height: 100rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.more-icon-text {
  width: 100rpx;
  height: 100rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.more-label {
  font-size: 22rpx;
  color: #666;
  margin-top: 12rpx;
}

/* 表情面板 */
.emoji-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 104rpx;
  background: #f7f7f7;
  padding: 24rpx;
  border-top: 1rpx solid #e5e5e5;
  max-height: 400rpx;
  overflow-y: auto;
  z-index: 20;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
}

.emoji-item {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.emoji-item:active {
  background: #e8e8e8;
  border-radius: 8rpx;
}

/* 快捷收款操作 */
.quick-actions {
  display: flex;
  justify-content: center;
  padding: 8rpx 16rpx 4rpx;
}

.quick-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  gap: 8rpx;
}

.quick-btn.pay-btn {
  background: linear-gradient(135deg, #07c160, #06ad56);
}

.quick-btn.ask-btn {
  background: linear-gradient(135deg, #ff9500, #ff6b35);
}

.quick-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* 收款码卡片消息 */
.paycode-row {
  align-items: flex-start;
}

.paycode-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.paycode-card.self-paycode {
  margin-right: 16rpx;
  background: #fffef0;
  border: 2rpx solid #ffe58f;
}

.paycode-card.other-paycode {
  margin-left: 16rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
}

.paycode-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.paycode-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.chat-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  background: rgba(0, 0, 0, 0.5);
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
}

.loading-text {
  color: #fff;
  font-size: 28rpx;
}

.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
}

.chat-empty .empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.chat-empty .empty-text {
  font-size: 26rpx;
  color: #999;
}

.image-row {
  align-items: flex-start;
}

.msg-image {
  max-width: 400rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  display: block;
}

.self .msg-image {
  margin-right: 16rpx;
}

.other .msg-image {
  margin-left: 16rpx;
}