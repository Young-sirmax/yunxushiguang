/* pages/bookcorner/index.wxss —— 公益图书角主页 */
page {
  background: var(--bg);
}

.page-container {
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
  box-sizing: border-box;
}

.space-hero {
  margin: 24rpx 0 32rpx;
  padding: 48rpx 32rpx;
  border-radius: var(--radius-lg);
  background: var(--primary-grad-vivid);
  box-shadow: var(--shadow-primary);
  color: var(--white);
  text-align: center;
}

.space-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.space-logo.placeholder {
  font-size: 72rpx;
  line-height: 144rpx;
}

.space-name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.space-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.zone-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.zone-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 28rpx;
  transition: transform 0.15s ease;
}

.zone-card:active {
  transform: scale(0.985);
}

.zone-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--white);
  margin-right: 26rpx;
  flex-shrink: 0;
}

.zone-badge.zone-A {
  background: var(--primary-grad);
  box-shadow: 0 8rpx 20rpx rgba(var(--primary-rgb), 0.28);
}

.zone-badge.zone-B {
  background: var(--type-skill-grad);
  box-shadow: 0 8rpx 20rpx rgba(var(--type-skill-rgb), 0.24);
}

.zone-info {
  flex: 1;
  min-width: 0;
}

.zone-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.zone-desc {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.zone-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.zone-arrow {
  font-size: 44rpx;
  color: var(--text-light);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.footer-note {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}
