/* pages/admin_batch/admin_batch.wxss —— 管理员批量上架 */
page {
  background: var(--bg);
}

.page-container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--bg);
  padding-bottom: 80rpx;
}

/* 维护模式说明位 */
.notice-bar {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--warning-soft);
  border: 1rpx solid var(--price-soft);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.notice-icon {
  font-size: 28rpx;
  line-height: 1.5;
}

.notice-text {
  flex: 1;
  font-size: 23rpx;
  color: var(--warning);   /* 状态/提示语义，不是价格 */
  line-height: 1.6;
}

/* Tab（4 个 Tab 起用横向 scroll-view 承载，避免挤压） */
.tab-scroll {
  width: 100%;
  margin-bottom: 24rpx;
}

.tab-bar {
  display: flex;
  padding: 6rpx;
  background: var(--fill-strong);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1 0 auto;
  min-width: 158rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: 999rpx;
  transition: all 0.25s ease;
}

.tab-item.active {
  background: var(--primary-grad);
  color: var(--white);
  box-shadow: var(--shadow-primary);
}

.tab-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--primary);
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.card {
  background: var(--white);
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 26rpx rgba(var(--text-rgb), 0.05);
}

.card.empty {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.pick-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border: 2rpx dashed var(--fill-strong);
  border-radius: 20rpx;
}

.pick-icon {
  font-size: 32rpx;
}

.pick-text {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-secondary);
}

.tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* 预览行 */
.row-list {
  margin-bottom: 20rpx;
}

.row-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--fill);
}

.row-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.row-no {
  font-size: 22rpx;
  color: var(--text-light);
}

.row-type {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
  color: var(--primary-dark);
}

.row-img {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
  color: var(--primary-dark);
}

/* 已导入：与基础 .row-img 同色，此处显式声明，避免依赖隐式继承 */
.row-img.ok {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.row-img.missing {
  background: var(--error-soft);
  color: var(--error);
}

.row-img.none {
  background: var(--fill);
  color: var(--text-light);
}

.row-title {
  display: block;
  font-size: 27rpx;
  color: var(--text);
  line-height: 1.5;
}

.row-skip {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--error);
}

.row-more {
  padding-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-light);
  text-align: center;
}

/* 进度 */
.progress {
  margin: 20rpx 0;
}

.progress-bar {
  height: 16rpx;
  background: var(--fill-strong);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: var(--primary-grad);
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.progress-text {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-light);
  text-align: center;
}

.summary {
  margin-top: 18rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
}

.fail-title {
  margin-top: 22rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--error);
}

.fail-item {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--bg);
}

.fail-no {
  flex-shrink: 0;
  font-size: 23rpx;
  color: var(--text-light);
}

.fail-err {
  flex: 1;
  font-size: 23rpx;
  color: var(--error);
  word-break: break-all;
}

/* 手动录入 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-cell {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--fill);
}

.img-thumb {
  width: 100%;
  height: 100%;
}

.img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: var(--white);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.img-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--fill-strong);
  background: var(--bg);
  font-size: 52rpx;
  color: var(--text-light);
}

.field {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--fill);
}

.field:last-child {
  border-bottom: none;
}

.field.column {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--text-secondary);
}

.field.column .label {
  margin-bottom: 14rpx;
}

.input,
.picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.textarea {
  width: 100%;
  height: 200rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 1.6;
}

/* 待上架 */
.draft-item {
  padding: 24rpx;
}

.draft-top {
  display: flex;
  align-items: flex-start;
}

.draft-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: var(--fill);
  flex-shrink: 0;
}

.draft-meta {
  flex: 1;
  min-width: 0;
}

.draft-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.draft-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--price);
}

.draft-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  font-size: 21rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--text-secondary);
}

.draft-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.mini-btn {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.mini-btn.primary {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.mini-btn.danger {
  color: var(--error);
  background: var(--error-soft);
}

/* 通用按钮 */
.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--white);
  background: var(--primary-grad);
  box-shadow: var(--shadow-primary);
}

.btn-ghost {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--primary-dark);
  background: var(--primary-light);
  margin-top: 18rpx;
}

.mini-btn.warn {
  color: var(--warning-dark);
  background: var(--warning-soft);
}

/* ===== 极简上架（默认主流程） ===== */

/* 底部固定主按钮占位，避免内容被遮住 */
.page-container.has-bottom-bar {
  padding-bottom: 220rpx;
}

.pick-row.big {
  height: 140rpx;
  border-color: var(--primary);
  background: var(--primary-light);
}

.pick-row.big .pick-text {
  color: var(--primary-dark);
  font-weight: 600;
}

.pick-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

.quick-card {
  padding: 20rpx 28rpx;
}

.quick-row {
  display: flex;
  gap: 16rpx;
}

.quick-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-dark);
  background: var(--primary-light);
}

.simple-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.simple-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: var(--fill);
  flex-shrink: 0;
}

.simple-meta {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.simple-status {
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 14rpx;
}

.simple-status.done {
  color: var(--success-dark);
}

.simple-status.fail {
  color: var(--error);
}

.simple-status.uploading {
  color: var(--warning-dark);
}

.simple-price-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--bg);
  border-radius: 16rpx;
}

.simple-price-label {
  font-size: 25rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.simple-price-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text);
}

.simple-price-unit {
  font-size: 24rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.simple-ops {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.simple-ops .mini-btn {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
}

.summary-card {
  font-size: 25rpx;
  color: var(--text-secondary);
}

/* 待上架：面议价格用弱化色，不抢价格色的视觉位 */
.draft-price.muted {
  color: var(--text-light);
  font-weight: 600;
}

/* ===== 高级模式子 Tab ===== */
.sub-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.sub-item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--white);
}

.sub-item.active {
  color: var(--primary-dark);
  background: var(--primary-light);
}

/* ===== 授权（仅超管） ===== */
.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin: 16rpx 0;
}

.search-input {
  flex: 1;
  height: 84rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border-radius: 999rpx;
  font-size: 27rpx;
  color: var(--text);
  box-sizing: border-box;
}

.search-btn {
  flex-shrink: 0;
  height: 84rpx;
  padding: 0 36rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--white);
  background: var(--primary-grad);
}

.share-invite {
  margin-top: 18rpx;
}

.candidate,
.admin-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--fill);
}

.candidate:last-child,
.admin-item:last-child {
  border-bottom: none;
}

.candidate-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--fill);
  flex-shrink: 0;
}

.candidate-meta {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.admin-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.candidate-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}

.candidate-school {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.admin-note {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.admin-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--text-secondary);
}

.admin-tag.revoked {
  background: var(--error-soft);
  color: var(--error);
}

.admin-tag.invite {
  background: var(--info-soft);
  color: var(--info);
}

.admin-loading {
  padding: 20rpx 0;
  font-size: 25rpx;
  color: var(--text-light);
  text-align: center;
}

/* ===== 底部固定主按钮（单手可达，热区 ≥ 44px） ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--white);
  box-shadow: 0 -6rpx 24rpx rgba(var(--text-rgb), 0.06);
  z-index: 10;
}

.bottom-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  text-align: center;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
  border: none;
}

.bottom-btn::after {
  border: none;
}

.bottom-btn.primary {
  color: var(--white);
  background: var(--primary-grad);
  box-shadow: var(--shadow-primary);
}

.bottom-btn.primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.bottom-btn.ghost {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.bottom-btn.full {
  flex: 1 0 100%;
}
