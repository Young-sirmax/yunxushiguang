/* pages/admin_batch/admin_batch.wxss —— 管理员批量上架 */
page {
  background: #f5f7fa;
}

.page-container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  padding-bottom: 80rpx;
}

/* 维护模式说明位 */
.notice-bar {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #fff7e6;
  border: 1rpx solid #ffe0b2;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.notice-icon {
  font-size: 28rpx;
  line-height: 1.5;
}

.notice-text {
  flex: 1;
  font-size: 23rpx;
  color: #b45309;
  line-height: 1.6;
}

/* Tab */
.tab-bar {
  display: flex;
  padding: 6rpx;
  background: #eef2f6;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: 999rpx;
  transition: all 0.25s ease;
}

.tab-item.active {
  background: var(--primary-grad);
  color: #fff;
  box-shadow: var(--shadow-primary);
}

.tab-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--primary);
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.card {
  background: #fff;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 26rpx rgba(15, 27, 45, 0.05);
}

.card.empty {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #14202f;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.pick-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx dashed #d7dee8;
  border-radius: 20rpx;
}

.pick-icon {
  font-size: 32rpx;
}

.pick-text {
  flex: 1;
  font-size: 27rpx;
  color: #3e4e62;
}

.tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* 预览行 */
.row-list {
  margin-bottom: 20rpx;
}

.row-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.row-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.row-no {
  font-size: 22rpx;
  color: #94a3b8;
}

.row-type {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
}

.row-img {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
}

.row-img.missing {
  background: var(--danger-soft);
  color: var(--danger);
}

.row-img.none {
  background: #eef1f5;
  color: #94a3b8;
}

.row-title {
  display: block;
  font-size: 27rpx;
  color: #14202f;
  line-height: 1.5;
}

.row-skip {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--danger);
}

.row-more {
  padding-top: 16rpx;
  font-size: 23rpx;
  color: #94a3b8;
  text-align: center;
}

/* 进度 */
.progress {
  margin: 20rpx 0;
}

.progress-bar {
  height: 16rpx;
  background: #eef2f6;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: var(--primary-grad);
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.progress-text {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #94a3b8;
  text-align: center;
}

.summary {
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #3e4e62;
}

.fail-title {
  margin-top: 22rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--danger);
}

.fail-item {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f7f9fc;
}

.fail-no {
  flex-shrink: 0;
  font-size: 23rpx;
  color: #94a3b8;
}

.fail-err {
  flex: 1;
  font-size: 23rpx;
  color: var(--danger);
  word-break: break-all;
}

/* 手动录入 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-cell {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5fa;
}

.img-thumb {
  width: 100%;
  height: 100%;
}

.img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.img-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d7dee8;
  background: #fafbfd;
  font-size: 52rpx;
  color: #b0b8c4;
}

.field {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.field:last-child {
  border-bottom: none;
}

.field.column {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #7b8a9c;
}

.field.column .label {
  margin-bottom: 14rpx;
}

.input,
.picker {
  flex: 1;
  font-size: 28rpx;
  color: #14202f;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 1.6;
}

/* 待上架 */
.draft-item {
  padding: 24rpx;
}

.draft-top {
  display: flex;
  align-items: flex-start;
}

.draft-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.draft-meta {
  flex: 1;
  min-width: 0;
}

.draft-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #14202f;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.draft-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

.draft-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  font-size: 21rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #7b8a9c;
}

.draft-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.mini-btn {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.mini-btn.primary {
  color: var(--primary);
  background: var(--primary-soft);
}

.mini-btn.danger {
  color: var(--danger);
  background: var(--danger-soft);
}

/* 通用按钮 */
.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: var(--primary-grad);
  box-shadow: var(--shadow-primary);
}

.btn-ghost {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-soft);
  margin-top: 18rpx;
}
