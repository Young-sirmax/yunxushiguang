/* pages/commodity_search/commodity_search.wxss */
.page-container {
  background: var(--bg);
  min-height: 100vh;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg-card);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 12rpx rgba(15, 27, 45, 0.04);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: var(--radius-pill);
  padding: 14rpx 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.search-box:focus-within {
  background: var(--white);
  border-color: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(0, 193, 126, 0.08);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-box input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.clear-btn {
  color: var(--text-light);
  font-size: 28rpx;
  padding: 0 8rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 20rpx;
  font-weight: 500;
}

.cancel-btn:active {
  color: var(--primary);
}

.result-list {
  padding: 20rpx 24rpx;
}

.commodity-card {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: transform 0.2s ease;
}

.commodity-card:active {
  transform: scale(0.98);
}

.card-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.card-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  line-height: 1.4;
}

.price-group {
  display: flex;
  align-items: baseline;
}

.card-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent);
  margin-right: 10rpx;
}

.card-price.want {
  color: var(--primary);
}

.card-tags {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  gap: 12rpx;
}

.verified-tag {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}

/* 图书专区：适用专业标签 */
.major-tag {
  font-size: 20rpx;
  color: var(--want);
  background: var(--want-soft);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
  max-width: 380rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.original-price {
  font-size: 22rpx;
  color: var(--text-light);
  text-decoration: line-through;
}

.empty {
  text-align: center;
  padding-top: 200rpx;
  color: var(--text-light);
}
/* === 类型角标 / 交易状态 / 以物易物价格 === */
.card-price.exchange {
  color: var(--exchange);
  font-size: 24rpx;
}

.type-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
  flex-shrink: 0;
}

.type-tag.want {
  color: var(--want);
  background: var(--want-soft);
}

.type-tag.exchange {
  color: var(--exchange);
  background: var(--exchange-soft);
}

.trade-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-weight: 600;
  color: #b45309;
  background: #fef3c7;
  flex-shrink: 0;
}

.card-price.skill {
  color: var(--skill);
  font-size: 24rpx;
}
