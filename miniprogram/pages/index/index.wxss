/* pages/index/index.wxss */
.login-container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-image {
  width: 100%;
  height: 100%;
}

/* 更精致的遮罩：翡翠渐变 + 顶部光斑 */
.bg-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 80% 10%, rgba(var(--primary-rgb), 0.28) 0%, transparent 45%),
    linear-gradient(180deg, rgba(var(--primary-rgb), 0.9) 0%, rgba(var(--primary-rgb), 0.68) 45%, rgba(var(--text-rgb), 0.52) 100%);
}

.login-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.logo-area {
  text-align: center;
  margin-bottom: 88rpx;
  animation: fadeInUp 0.6s ease;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 12rpx 28rpx rgba(var(--text-rgb), 0.3));
}

.logo-title {
  font-size: 50rpx;
  font-weight: 700;
  color: var(--white);
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 20rpx rgba(var(--text-rgb), 0.25);
}

.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}

.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  padding: 56rpx 44rpx 48rpx;
  box-shadow: 0 24rpx 80rpx rgba(var(--text-rgb), 0.28);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  animation: fadeInUp 0.6s ease 0.1s both;
}

.welcome-text {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  margin-bottom: 14rpx;
}

.welcome-desc {
  font-size: 27rpx;
  color: var(--text-light);
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.school-input-wrap {
  display: flex;
  align-items: center;
  background: var(--fill);
  border: 2rpx solid var(--fill-strong);
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 96rpx;
  margin-bottom: 28rpx;
  transition: border-color 0.2s ease;
}

.school-input-wrap:focus-within {
  border-color: var(--primary);
  background: var(--white);
}

.school-input-icon {
  font-size: 32rpx;
  margin-right: 18rpx;
}

.school-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  height: 96rpx;
  line-height: 96rpx;
}

.school-input-placeholder {
  color: var(--text-light);
  font-size: 28rpx;
}

.login-btn {
  width: 100%;
  margin-bottom: 36rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.agreement-row checkbox {
  transform: scale(0.7);
  margin-right: 8rpx;
}

.agreement-text {
  line-height: 1.6;
}

.link {
  color: var(--primary);
}

.footer-text {
  margin-top: 64rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 6rpx;
}

/* 毛玻璃浏览入口 */
.browse-entry {
  margin-top: 44rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 44rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 100rpx;
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  box-shadow: 0 8rpx 24rpx rgba(var(--text-rgb), 0.18);
  transition: transform 0.2s ease;
}

.browse-entry:active {
  transform: scale(0.96);
}

.browse-text {
  font-size: 28rpx;
  color: var(--white);
  font-weight: 500;
}

.browse-arrow {
  font-size: 32rpx;
  color: var(--white);
  margin-left: 8rpx;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}
