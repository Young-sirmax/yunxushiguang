/* pages/index/index.wxss */
.login-container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.bg-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(7,193,96,0.85) 0%, rgba(7,193,96,0.6) 50%, rgba(0,0,0,0.4) 100%);
}

.login-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.logo-area {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.logo-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 12rpx;
}

.login-card {
  width: 100%;
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
  backdrop-filter: blur(10rpx);
}

.welcome-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 48rpx;
}

.login-btn {
  width: 100%;
  margin-bottom: 32rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  color: #666;
}

.agreement-row checkbox {
  transform: scale(0.7);
  margin-right: 8rpx;
}

.agreement-text {
  line-height: 1.6;
}

.link {
  color: #07c160;
}

.footer-text {
  margin-top: 60rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  letter-spacing: 4rpx;
}
