/* pages/business/business.wxss */
.page-container {
  padding: 0 0 48rpx;
  min-height: 100vh;
  background: var(--bg);
}

.service-header {
  position: relative;
  padding: calc(env(safe-area-inset-top) + 80rpx) 24rpx 56rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200%;
  background: var(--primary-grad);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--white);
  letter-spacing: 2rpx;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 8rpx;
  line-height: 1.5;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.feature-section {
  padding: 32rpx 24rpx 0;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-card {
  display: flex;
  align-items: center;
}

.feature-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
}

.feature-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  display: block;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.feature-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.feature-tag.free {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.guide-section {
  padding: 32rpx 24rpx 0;
}

.guide-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.guide-step-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.guide-step-row:last-of-type {
  margin-bottom: 32rpx;
}

.step-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--primary-grad);
  color: var(--white);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
  margin-bottom: 6rpx;
}

.step-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  background: var(--primary-grad);
  color: var(--white);
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-top: 8rpx;
}

.primary-btn::after {
  border: none;
}

.operator-card {
  margin: 32rpx 24rpx 0;
  background: var(--img-ph-grad);
}

.operator-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.operator-info {
  display: flex;
  flex-direction: column;
}

.operator-label {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 6rpx;
}

.operator-wechat {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.copy-btn {
  height: 64rpx;
  padding: 0 28rpx;
  background: var(--primary-grad);
  color: var(--white);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 100rpx;
  line-height: 64rpx;
  border: none;
}

.copy-btn::after {
  border: none;
}

.operator-tip {
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.operator-tip text {
  display: block;
}