<!--pages/business/business.wxml-->
<view class="page-container">
  <!-- 顶部标题 -->
  <view class="service-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-title">校园信息服务站</text>
      <text class="header-desc">免费发布 · 免费曝光 · 免费认证</text>
    </view>
  </view>

  <!-- 功能说明 -->
  <view class="feature-section">
    <view class="section-header">
      <text class="section-emoji">✨</text>
      <text class="section-title">免费开放的功能</text>
    </view>

    <view class="feature-list">
      <view class="feature-card card">
        <view class="feature-icon">📝</view>
        <view class="feature-info">
          <text class="feature-name">信息发布</text>
          <text class="feature-desc">出售闲置、求购信息，不限条数</text>
        </view>
        <view class="feature-tag free">免费</view>
      </view>

      <view class="feature-card card">
        <view class="feature-icon">🖼️</view>
        <view class="feature-info">
          <text class="feature-name">多图发布</text>
          <text class="feature-desc">支持 9 张图片 + 1 个视频</text>
        </view>
        <view class="feature-tag free">免费</view>
      </view>

      <view class="feature-card card">
        <view class="feature-icon">🔥</view>
        <view class="feature-info">
          <text class="feature-name">急出标签</text>
          <text class="feature-desc">帖子角标变红，提升曝光</text>
        </view>
        <view class="feature-tag free">免费</view>
      </view>

      <view class="feature-card card">
        <view class="feature-icon">📌</view>
        <view class="feature-info">
          <text class="feature-name">置顶展示</text>
          <text class="feature-desc">固定在分类信息流顶部 24 小时</text>
        </view>
        <view class="feature-tag free">免费</view>
      </view>

      <view class="feature-card card">
        <view class="feature-icon">🎯</view>
        <view class="feature-info">
          <text class="feature-name">精准推送</text>
          <text class="feature-desc">推送到 3 个垂直分类</text>
        </view>
        <view class="feature-tag free">免费</view>
      </view>

      <view class="feature-card card">
        <view class="feature-icon">🛡️</view>
        <view class="feature-info">
          <text class="feature-name">学生认证</text>
          <text class="feature-desc">上传学生证/校园卡，提升信任度</text>
        </view>
        <view class="feature-tag free">免费</view>
      </view>
    </view>
  </view>

  <!-- 使用指引 -->
  <view class="guide-section">
    <view class="section-header">
      <text class="section-emoji">📖</text>
      <text class="section-title">如何使用</text>
    </view>

    <view class="guide-card card">
      <view class="guide-step-row">
        <view class="step-badge">1</view>
        <view class="step-content">
          <text class="step-title">登录账号</text>
          <text class="step-desc">使用微信一键登录，开启全部功能</text>
        </view>
      </view>
      <view class="guide-step-row">
        <view class="step-badge">2</view>
        <view class="step-content">
          <text class="step-title">发布信息</text>
          <text class="step-desc">选择出售或求购，填写信息并上传图片</text>
        </view>
      </view>
      <view class="guide-step-row">
        <view class="step-badge">3</view>
        <view class="step-content">
          <text class="step-title">等待审核</text>
          <text class="step-desc">管理员审核后，信息将展示在信息流中</text>
        </view>
      </view>
      <view class="guide-step-row">
        <view class="step-badge">4</view>
        <view class="step-content">
          <text class="step-title">联系交易</text>
          <text class="step-desc">买家/卖家通过联系方式自行沟通交易</text>
        </view>
      </view>
      <button class="primary-btn" bindtap="goRelease">立即发布信息</button>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="operator-card card">
    <view class="operator-row">
      <view class="operator-info">
        <text class="operator-label">运营者微信</text>
        <text class="operator-wechat">{{operatorWechat}}</text>
      </view>
      <button class="copy-btn" bindtap="copyWechat">复制微信号</button>
    </view>
    <view class="operator-tip">
      <text>本平台为免费信息展示平台 · 不参与交易 · 不收取任何费用</text>
    </view>
  </view>
</view>