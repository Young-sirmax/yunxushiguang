/* pages/commodity_detail/commodity_detail.wxss */
.page-container {
  padding-bottom: 180rpx;
}

.image-swiper {
  height: 600rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.info-section {
  margin: 24rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff4d4f;
  margin-right: 16rpx;
}

.price.want {
  color: #07c160;
}

.reward-label {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #07c160, #00b86b);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.original-price {
  font-size: 26rpx;
  color: #bbb;
  text-decoration: line-through;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: block;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.meta-tag.condition {
  background: #e6f7ed;
  color: #07c160;
}

.meta-tag.duration {
  background: #e6f4ff;
  color: #1890ff;
}

.meta-time {
  font-size: 22rpx;
  color: #bbb;
}

.priv-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 12rpx;
}

.priv-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.priv-tag.urgent {
  background: linear-gradient(135deg, #ff6b6b, #ff4d4f);
  color: #fff;
}

.priv-tag.top {
  background: linear-gradient(135deg, #ff9900, #ff6b35);
  color: #fff;
}

.priv-tag.multi {
  background: linear-gradient(135deg, #4facfe, #00c6fb);
  color: #fff;
}

.priv-tag.precision {
  background: linear-gradient(135deg, #a18cd1, #fbc2eb);
  color: #fff;
}

.seller-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.verified-badge {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #07c160, #00d97e);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.3);
}

.seller-section, .location-section, .desc-section {
  margin: 0 24rpx 24rpx;
}

.seller-header, .section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.seller-info {
  display: flex;
  align-items: center;
}

.seller-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
}

.seller-meta {
  display: flex;
  flex-direction: column;
}

.seller-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.seller-contact {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.location-text, .desc-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.bottom-left {
  display: flex;
  flex-shrink: 0;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: inherit;
  flex-shrink: 0;
  min-width: 80rpx;
  transition: transform 0.2s ease;
}

.action-btn:active {
  transform: scale(0.92);
}

.action-btn.favorited .action-icon {
  animation: pop 0.4s ease;
}

.action-btn.chat-btn .action-icon {
  color: #07c160;
}

@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}

.action-btn::after {
  border: none;
}

.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 20rpx;
  color: #666;
  white-space: nowrap;
}

.trade-btn {
  width: 220rpx;
  height: 72rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

/* 复制联系方式按钮 */
.copy-contact-btn {
  margin-left: auto;
  padding: 10rpx 24rpx;
  background: #07c160;
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.copy-contact-btn:active {
  opacity: 0.8;
}

.seller-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f6ffed;
  border-radius: 8rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #52c41a;
  line-height: 1.5;
}