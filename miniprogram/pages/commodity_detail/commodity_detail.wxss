/* pages/commodity_detail/commodity_detail.wxss */
.page-container {
  padding-bottom: 180rpx;
}

.image-swiper {
  height: 600rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.info-section {
  margin: 24rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--accent);
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.price.want {
  color: var(--primary);
}

.reward-label {
  font-size: 22rpx;
  color: var(--white);
  background: var(--primary-grad);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
  margin-left: 8rpx;
  box-shadow: var(--shadow-primary);
}

.original-price {
  font-size: 26rpx;
  color: var(--text-light);
  text-decoration: line-through;
}

.price-note {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  background: #f6f8fb;
  border-radius: var(--radius);
  padding: 14rpx 20rpx;
  margin-top: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: block;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.meta-tag.condition {
  background: var(--primary-soft);
  color: var(--primary);
}

.meta-tag.duration {
  background: var(--info-soft);
  color: var(--info);
}

.meta-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.priv-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 12rpx;
}

.priv-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.priv-tag.urgent {
  background: linear-gradient(135deg, #ff7a8a, #f43f5e);
  color: var(--white);
}

.priv-tag.top {
  background: linear-gradient(135deg, #ff9900, #ff6b35);
  color: #fff;
}

.priv-tag.multi {
  background: linear-gradient(135deg, #4facfe, #00c6fb);
  color: #fff;
}

.priv-tag.precision {
  background: linear-gradient(135deg, #a18cd1, #fbc2eb);
  color: #fff;
}

.seller-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.verified-badge {
  font-size: 20rpx;
  color: var(--white);
  background: var(--primary-grad);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 193, 126, 0.3);
}

.seller-section, .location-section, .desc-section {
  margin: 0 24rpx 24rpx;
}

.seller-header, .section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}

.seller-info {
  display: flex;
  align-items: center;
}

.seller-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
}

.seller-meta {
  display: flex;
  flex-direction: column;
}

.seller-name {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.seller-contact {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.location-text, .desc-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(15, 27, 45, 0.08);
  border-top: 1rpx solid var(--border);
  z-index: 100;
}

.bottom-left {
  display: flex;
  flex-shrink: 0;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: inherit;
  flex-shrink: 0;
  min-width: 80rpx;
  transition: transform 0.2s ease;
}

.action-btn:active {
  transform: scale(0.92);
}

.action-btn.favorited .action-icon {
  animation: pop 0.4s ease;
}

@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}

.action-btn::after {
  border: none;
}

.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.trade-btn {
  width: 220rpx;
  height: 72rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

/* 复制联系方式按钮 */
.copy-contact-btn {
  margin-left: auto;
  padding: 10rpx 24rpx;
  background: var(--primary);
  color: var(--white);
  font-size: 24rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 193, 126, 0.25);
}

.copy-contact-btn:active {
  opacity: 0.8;
}

.seller-tip {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  background: var(--primary-soft);
  border-radius: var(--radius);
}

.tip-text {
  font-size: 22rpx;
  color: var(--primary-dark);
  line-height: 1.5;
}