/* pages/commodity_detail/commodity_detail.wxss */
.page-container {
  /* 底部固定操作栏 + 安全区 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.image-swiper {
  height: 600rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

/* 轮播单元：作为骨架/图片/失败占位的定位容器 */
.swiper-cell {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--fill-strong);
  overflow: hidden;
}

/* 加载失败占位：点击可重试 */
.img-fail {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--fill);
}

.img-fail-icon {
  font-size: 68rpx;
  margin-bottom: 12rpx;
  opacity: 0.7;
}

.img-fail-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.info-section {
  margin: 24rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--price);
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.price.want {
  color: var(--primary);
}

.reward-label {
  font-size: 22rpx;
  color: var(--white);
  background: var(--primary-grad);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
  margin-left: 8rpx;
  box-shadow: var(--shadow-primary);
}

.original-price {
  font-size: 26rpx;
  color: var(--text-light);
  text-decoration: line-through;
}

.price-note {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 14rpx 20rpx;
  margin-top: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: block;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.meta-tag.condition {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.meta-tag.duration {
  background: var(--info-soft);
  color: var(--info);
}

.meta-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.priv-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 12rpx;
}

.priv-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.priv-tag.urgent {
  background: var(--error-grad);
  color: var(--white);
}

.priv-tag.top {
  background: var(--price-grad);
  color: var(--white);
}

.priv-tag.multi {
  background: var(--type-skill-text);
  color: var(--white);
}

.priv-tag.precision {
  background: var(--type-wanted-text);
  color: var(--white);
}

.seller-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.verified-badge {
  font-size: 20rpx;
  color: var(--white);
  background: var(--primary-grad);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(var(--primary-rgb), 0.3);
}

.seller-section, .location-section, .desc-section {
  margin: 0 24rpx 24rpx;
}

.seller-header, .section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}

.seller-info {
  display: flex;
  align-items: center;
}

.seller-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: var(--fill-strong);
}

.seller-meta {
  display: flex;
  flex-direction: column;
}

.seller-name {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.seller-contact {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.location-text, .desc-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(var(--text-rgb), 0.08);
  border-top: 1rpx solid var(--border);
  z-index: 100;
}

.bottom-left {
  display: flex;
  flex-shrink: 0;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: inherit;
  flex-shrink: 0;
  min-width: 80rpx;
  transition: transform 0.2s ease;
}

.action-btn:active {
  transform: scale(0.92);
}

.action-btn.favorited .action-icon {
  animation: pop 0.4s ease;
}

@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}

.action-btn::after {
  border: none;
}

.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.trade-btn {
  width: 220rpx;
  height: 72rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

/* 复制联系方式按钮 */
.copy-contact-btn {
  margin-left: auto;
  padding: 10rpx 24rpx;
  background: var(--primary);
  color: var(--white);
  font-size: 24rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(var(--primary-rgb), 0.25);
}

.copy-contact-btn:active {
  opacity: 0.8;
}

.seller-tip {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  background: var(--primary-light);
  border-radius: var(--radius);
}

.tip-text {
  font-size: 22rpx;
  color: var(--primary-dark);
  line-height: 1.5;
}
/* === 以物易物 / 交易状态 / 联系方式（仅复制不明文展示） === */
.price.exchange {
  color: var(--type-exchange-text);
  font-size: 36rpx;
  font-weight: 700;
}

.meta-tag.trade-status {
  color: var(--warning-dark);   /* 状态/提示语义，不是价格 */;
  background: var(--warning-soft);
  font-weight: 600;
}

.exchange-box {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--type-wanted-soft);
  border-radius: 16rpx;
}

.exchange-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.exchange-row:last-child {
  margin-bottom: 0;
}

.exchange-label {
  flex-shrink: 0;
  width: 180rpx;
  font-size: 26rpx;
  color: var(--text-light);
}

.exchange-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--type-wanted-deep);
  font-weight: 500;
  word-break: break-all;
}

.seller-contact-hint {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.copy-contact-btn.disabled {
  opacity: 0.45;
}

/* === 发布者：交易状态操作 === */
.owner-section {
  margin-bottom: 24rpx;
}

.owner-trade-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.trade-chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--fill);
  transition: all 0.2s ease;
}

.trade-chip.active {
  background: var(--primary-grad);
  color: var(--white);
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

/* === 技能服务 / 达人 / 评价 === */
.skill-box .exchange-value {
  color: var(--type-skill-text);
}

.expert-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: var(--type-skill-text);
  background: var(--type-skill-soft);
}

.expert-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  background: var(--warning-soft);
  border-radius: 16rpx;
}

.expert-rating {
  font-size: 24rpx;
  color: var(--type-skill-text);
}

.expert-link {
  font-size: 24rpx;
  color: var(--type-skill-text);
  font-weight: 600;
}

.expert-intro {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  word-break: break-all;
}

.review-entry {
  margin-top: 20rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--type-skill-text);
  background: var(--type-skill-soft);
}

.review-entry.done {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.price.skill {
  color: var(--type-skill-text);
  font-size: 36rpx;
  font-weight: 700;
}

/* 技能分类标签 */
.meta-tag.skill-cat {
  color: var(--type-skill-text);
  background: var(--type-skill-soft);
}
