/* pages/home_release/home_release.wxss */
.page-container { padding: 24rpx; }
.section-title { font-size: 28rpx; color: #333; margin: 16rpx 0; font-weight: 600; }
.section-hint { font-size: 22rpx; color: #999; font-weight: normal; margin-left: 8rpx; }
.item-card { display: flex; align-items: center; margin-bottom: 20rpx; padding: 20rpx; }
.item-card.deleted { opacity: 0.75; background: #fafafa; }
.item-img { width: 160rpx; height: 160rpx; border-radius: 8rpx; margin-right: 20rpx; background: #f0f0f0; }
.item-info { flex: 1; }
.item-title { font-size: 28rpx; color: #333; margin-bottom: 8rpx; display: block; }
.item-price { font-size: 30rpx; color: #ff4d4f; font-weight: bold; }
.item-price.want { color: #07c160; }
.item-status-row { display: flex; align-items: center; margin-top: 8rpx; gap: 12rpx; }
.item-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; display: inline-block; }
.verified-mini { font-size: 20rpx; color: #07c160; background: #e6f7ed; padding: 4rpx 12rpx; border-radius: 20rpx; }
.item-status.onsale { background: #e6f7ed; color: #07c160; }
.item-status.sold { background: #f5f5f5; color: #999; }
.item-status.deleted-status { background: #fff1f0; color: #ff4d4f; }
.item-actions { display: flex; flex-direction: column; }
.action-edit, .action-delete, .action-restore { font-size: 24rpx; padding: 8rpx 16rpx; margin: 4rpx 0; border-radius: 8rpx; text-align: center; }
.action-edit { color: #07c160; background: #e6f7ed; }
.action-delete { color: #ff4d4f; background: #fff1f0; }
.action-restore { color: #1890ff; background: #e6f4ff; }
.empty { text-align: center; padding-top: 200rpx; color: #999; }