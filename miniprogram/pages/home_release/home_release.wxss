/* pages/home_release/home_release.wxss —— 我发布的信息（闲置商品 / 求购物品 双分类） */
page {
  background: #f5f7fa;
}

.page-container {
  padding: 24rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

/* === 顶部双分类切换条 === */
.top-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f5f7fa;
  padding: 8rpx 0;
}

.seg-bar {
  flex: 1;
  display: flex;
  padding: 6rpx;
  background: #eef2f6;
  border-radius: 999rpx;
}

.seg {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 6rpx;
  border-radius: 999rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.25s ease;
}

.seg:active {
  transform: scale(0.97);
}

.seg.sell.active {
  background: var(--primary-grad);
  color: #fff;
  box-shadow: var(--shadow-primary);
}

.seg.want.active {
  background: var(--want-grad);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(161, 140, 209, 0.28);
}

.seg-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #dde4ec;
  color: #7c8ba1;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.seg.sell.active .seg-badge {
  background: rgba(255, 255, 255, 0.95);
  color: var(--primary);
}

.seg.want.active .seg-badge {
  background: rgba(255, 255, 255, 0.95);
  color: var(--want);
}

.publish-quick {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 18rpx 26rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
}

.quick-plus {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}

.quick-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.publish-quick:active {
  transform: scale(0.95);
}

/* === 空状态 === */
.tab-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 28rpx;
  opacity: 0.85;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 40rpx;
  text-align: center;
}

.empty-btn {
  padding: 20rpx 60rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  transition: transform 0.2s;
}

.empty-btn.sell {
  background: var(--primary-grad);
  box-shadow: var(--shadow-primary);
}

.empty-btn.want {
  background: var(--want-grad);
  box-shadow: 0 10rpx 30rpx rgba(161, 140, 209, 0.26);
}

.empty-btn:active {
  transform: scale(0.95);
}

/* === 信息列表 === */
.commodity-list {
  margin-bottom: 12rpx;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 27, 45, 0.06);
  transition: transform 0.2s ease;
}

.item-card:active {
  transform: scale(0.985);
}

.item-card.deleted {
  opacity: 0.72;
  background: #f6f8fb;
}

.item-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 20rpx;
  margin-right: 22rpx;
  background: linear-gradient(135deg, #eef5f1, #e0f8ef);
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 29rpx;
  color: var(--text);
  margin-bottom: 10rpx;
  display: block;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-mid {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.item-price {
  font-size: 32rpx;
  color: var(--accent);
  font-weight: 800;
}

.item-price.want {
  color: var(--want);
}

.item-status-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.item-status {
  font-size: 22rpx;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  display: inline-block;
  font-weight: 500;
}

.verified-mini {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.item-status.onsale {
  background: var(--primary-soft);
  color: var(--primary);
}

.item-status.sold {
  background: #eef1f5;
  color: var(--text-light);
}

.item-status.deleted-status {
  background: var(--danger-soft);
  color: var(--danger);
  margin-top: 10rpx;
  display: inline-block;
}

.item-status.pending {
  background: var(--warning-soft);
  color: var(--warning);
}

.item-status.rejected {
  background: var(--danger-soft);
  color: var(--danger);
}

.reject-reason {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 8rpx;
  word-break: break-all;
}

.review-hint {
  font-size: 22rpx;
  color: var(--warning);
  margin-top: 8rpx;
  line-height: 1.5;
}

/* === 操作按钮 === */
.item-actions {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.action-edit,
.action-delete,
.action-restore {
  font-size: 24rpx;
  padding: 9rpx 18rpx;
  margin: 5rpx 0;
  border-radius: 999rpx;
  text-align: center;
  transition: transform 0.2s ease;
}

.action-edit:active,
.action-delete:active,
.action-restore:active {
  transform: scale(0.93);
}

.action-edit {
  color: var(--primary);
  background: var(--primary-soft);
}

.action-delete {
  color: var(--danger);
  background: var(--danger-soft);
}

.action-restore {
  color: var(--want);
  background: var(--want-soft);
}

.section-title {
  font-size: 28rpx;
  color: var(--text);
  margin: 24rpx 4rpx 16rpx;
  font-weight: 600;
}

.section-hint {
  font-size: 22rpx;
  color: var(--text-light);
  font-weight: normal;
  margin-left: 8rpx;
}

/* === 以物易物：类型高亮 / 价格位文案 / 交易状态标签 === */
.seg.exchange.active {
  background: var(--exchange-grad);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(255, 154, 118, 0.3);
}

.seg.exchange.active .seg-badge {
  background: rgba(255, 255, 255, 0.95);
  color: var(--exchange);
}

.item-price.exchange {
  color: var(--exchange);
  font-size: 26rpx;
  font-weight: 600;
}

.item-status.trade {
  background: #fef3c7;
  color: #b45309;
  font-weight: 600;
}

.empty-btn.exchange {
  background: var(--exchange-grad);
  box-shadow: 0 10rpx 30rpx rgba(255, 154, 118, 0.28);
}

/* 技能服务：类型高亮 / 报价位 */
.seg.skill.active {
  background: var(--skill-grad);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(132, 193, 255, 0.32);
}

.seg.skill.active .seg-badge {
  background: rgba(255, 255, 255, 0.95);
  color: var(--skill);
}

.item-price.skill {
  color: var(--skill);
  font-size: 26rpx;
  font-weight: 600;
}

.empty-btn.skill {
  background: var(--skill-grad);
  box-shadow: 0 10rpx 30rpx rgba(132, 193, 255, 0.3);
}

.list-hint {
  text-align: center;
  font-size: 23rpx;
  color: #94a3b8;
  padding: 16rpx 0 8rpx;
}
