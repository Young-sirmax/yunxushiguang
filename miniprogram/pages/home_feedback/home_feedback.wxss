/* pages/home_feedback/home_feedback.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 280rpx;
}

.form-section {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.title-count {
  font-size: 24rpx;
  color: #999;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.type-item.active {
  background: #e6f7ed;
  border-color: #07c160;
}

.type-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.type-name {
  font-size: 26rpx;
  color: #333;
}

.type-item.active .type-name {
  color: #07c160;
}

.textarea-wrap {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
}

.feedback-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.input-wrap {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
}

.contact-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.feedback-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.image-delete {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  background: #f8f8f8;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #ccc;
  line-height: 1;
}

/* === 底部操作栏 === */
.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.action-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160, #00d97e);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  line-height: normal;
  padding: 0 32rpx;
}

.submit-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  animation: shimmer 2.5s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

.submit-btn.disabled {
  background: linear-gradient(135deg, #d5d5d5, #e8e8e8);
  color: #999;
  box-shadow: none;
  cursor: not-allowed;
}

.submit-btn.disabled::before {
  display: none;
}

.submit-btn-hover {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.25);
  transition: all 0.12s ease;
}

.submit-btn::after {
  border: none;
}

.btn-loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-icon {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  margin-right: 16rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.history-section {
  margin-top: 24rpx;
}

.history-list {
  padding: 0 24rpx;
}

.history-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-type {
  font-size: 26rpx;
  font-weight: 500;
  color: #07c160;
}

.history-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  background: #fff7e6;
  color: #fa8c16;
}

.status-processing {
  background: #e6f7ff;
  color: #1890ff;
}

.status-resolved {
  background: #e6f7ed;
  color: #07c160;
}

.status-rejected {
  background: #fff1f0;
  color: #ff4d4f;
}

.history-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.history-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-actions {
  display: flex;
  align-items: center;
}

.urge-count {
  font-size: 22rpx;
  color: #ff9900;
  margin-right: 16rpx;
}

.urge-btn {
  font-size: 24rpx;
  color: #07c160;
  background: #e6f7ed;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #07c160;
  transition: all 0.2s;
}

.urge-btn:active {
  background: #07c160;
  color: #fff;
  transform: scale(0.95);
}

.history-time {
  font-size: 24rpx;
  color: #999;
}
