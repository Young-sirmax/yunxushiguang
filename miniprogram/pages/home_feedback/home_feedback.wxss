/* pages/home_feedback/home_feedback.wxss —— 意见反馈（反馈交流群二维码页） */
page {
  background: linear-gradient(180deg, var(--primary-light) 0%, var(--bg) 360rpx);
}

.page-container {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

/* === 顶部欢迎区 === */
.fb-hero {
  position: relative;
  height: 200rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.fb-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--primary-grad-vivid);
}

.fb-hero-bg::after {
  content: '';
  position: absolute;
  top: -70rpx;
  right: -50rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--warning-rgb), 0.45) 0%, transparent 68%);
}

.fb-hero-inner {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 36rpx;
}

.fb-hero-title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--white);
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 10rpx rgba(var(--text-rgb), 0.22);
}

.fb-hero-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.6;
}

/* === 简介 === */
.intro-card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(var(--text-rgb), 0.06);
  margin-bottom: 24rpx;
}

.intro-text {
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* === 二维码卡片 === */
.qr-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 36rpx rgba(var(--text-rgb), 0.08);
  margin-bottom: 32rpx;
}

.qr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 28rpx;
}

/* 尺寸与图片实际比例 314×555 保持一致，避免 aspectFit 上下留白 */
.qr-img {
  width: 320rpx;
  height: 566rpx;
  border-radius: 20rpx;
  background: var(--white);
}

.qr-tip {
  font-size: 23rpx;
  color: var(--text-light);
  margin: 20rpx 0 26rpx;
}

.qr-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary-grad);
  color: var(--white);
  font-size: 29rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: var(--shadow-primary);
  transition: transform 0.2s ease;
}

.qr-btn:active {
  transform: scale(0.96);
}

/* === 二维码过期兜底：加运营者微信 === */
.qr-divider {
  width: 100%;
  height: 1rpx;
  background: var(--fill);
  margin: 30rpx 0 26rpx;
}

.wx-block {
  width: 100%;
}

.wx-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}

.wx-row {
  display: flex;
  align-items: center;
  background: var(--primary-light);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  transition: transform 0.2s ease;
}

.wx-row:active {
  transform: scale(0.98);
}

.wx-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.wx-id {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-dark);
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.wx-copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: var(--primary-grad);
  color: var(--white);
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

.wx-copy:active {
  opacity: 0.86;
}

.wx-tip {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* === 内容区块 === */
.block {
  margin-bottom: 30rpx;
}

.block-title {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding-left: 4rpx;
}

.dot {
  width: 10rpx;
  height: 32rpx;
  border-radius: 5rpx;
  background: var(--primary-grad);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot.warn {
  background: var(--warning-grad);
}

.bt-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.tpl-card,
.rule-card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 6rpx 26rpx rgba(var(--text-rgb), 0.05);
}

.tpl-sec {
  padding: 20rpx 0;
}

.tpl-divider {
  height: 1rpx;
  background: var(--fill);
}

.tpl-sec-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 14rpx;
}

.tpl-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.tpl-item:last-child {
  margin-bottom: 0;
}

.tpl-arrow {
  color: var(--primary);
  font-size: 26rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  line-height: 1.7;
}

.tpl-txt {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--bg);
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-ico {
  font-size: 26rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1.7;
}

.rule-item.no .rule-ico {
  opacity: 0.9;
}

.rule-txt {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.urgent-note {
  margin-top: 18rpx;
  background: var(--warning-soft);
  color: var(--warning-dark);   /* 状态/提示语义，不是价格 */;
  font-size: 25rpx;
  line-height: 1.6;
  border-radius: 18rpx;
  padding: 20rpx 26rpx;
  border-left: 6rpx solid var(--warning);
}

/* === 结尾致谢 === */
.thanks {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 10rpx;
}

.thanks-main {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.thanks-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
}
