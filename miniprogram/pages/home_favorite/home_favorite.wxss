.page-container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg);
}

.page-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.page-count {
  font-size: 26rpx;
  color: var(--text-light);
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.favorite-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: transform 0.2s ease;
}

.favorite-card:active {
  transform: scale(0.98);
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.item-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
}

.item-price {
  font-size: 32rpx;
  color: var(--accent);
  font-weight: 700;
  margin-right: 12rpx;
}

.item-price.want {
  color: var(--primary);
}

.item-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.verified-mini {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}

.item-original-price {
  font-size: 22rpx;
  color: var(--text-light);
  text-decoration: line-through;
}

.item-condition {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  display: inline-block;
  align-self: flex-start;
  margin-bottom: 4rpx;
  font-weight: 500;
}

.item-time {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.go-btn {
  background: var(--primary-grad);
  color: var(--white);
  box-shadow: 0 4rpx 12rpx rgba(0, 193, 126, 0.3);
}

.remove-btn {
  background: var(--white);
  color: var(--danger);
  border: 2rpx solid rgba(244, 63, 94, 0.5);
}

.remove-btn:active {
  background: var(--danger-soft);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 300rpx;
  height: 88rpx;
  font-size: 30rpx;
  text-align: center;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 32rpx;
}

.loading-tip, .no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--text-light);
}