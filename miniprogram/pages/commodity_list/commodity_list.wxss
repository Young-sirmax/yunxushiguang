/* pages/commodity_list/commodity_list.wxss */
page {
  background: var(--bg);
  overflow: hidden;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
  overflow: hidden;
}

/* === 渐变头部 === */
.hero-header {
  position: relative;
  padding: calc(env(safe-area-inset-top) + 100rpx) 24rpx 60rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200%;
  background: var(--primary-grad-vivid);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

/* 活力光斑点缀 */
.hero-bg::after {
  content: '';
  position: absolute;
  right: -90rpx;
  top: -70rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 197, 61, 0.35) 0%, rgba(255, 197, 61, 0) 65%);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-title-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 16rpx;
}

.search-input-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-light);
}

/* === 类型筛选（全部 / 闲置 / 求购） === */
.type-filter {
  display: flex;
  margin-top: 26rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  padding: 6rpx;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}

.type-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  transition: all 0.25s ease;
  font-weight: 500;
  white-space: nowrap;
  /* 五个类型筛选不撑破容器 */
  overflow: hidden;
  text-overflow: ellipsis;
}

.type-item.active {
  background: #fff;
  color: var(--primary);
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(0, 60, 40, 0.18);
}

.type-item.active.want {
  color: var(--want);
}

/* === 分类标签 === */
.category-scroll {
  background: #fff;
  white-space: nowrap;
  position: relative;
  z-index: 2;
  margin-top: -36rpx;
  border-radius: 28rpx 28rpx 0 0;
  flex-shrink: 0;
  /* 宽度约束在容器内，左右留白移到内层，避免 scroll-view 因 padding 溢出屏幕 */
  width: 100%;
  box-sizing: border-box;
}

.category-list {
  display: flex;
  padding: 16rpx 24rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #f1f5f9;
  border-radius: 30rpx;
  transition: all 0.25s ease;
  font-weight: 500;
  flex-shrink: 0;
  white-space: nowrap;
  /* 超长分类名不再撑出边界：限宽 + 省略号（与全局 chip 方案一致） */
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.category-item.active {
  background: var(--primary-grad);
  color: var(--white);
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

/* === 图书专区：二级筛选（学院 → 专业） === */
.book-filter {
  background: #fff;
  padding: 6rpx 0 16rpx;
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  border-bottom: 1rpx solid #f1f5f9;
  /* 防止胶囊横向溢出，遮挡右侧屏幕 */
  overflow: hidden;
}

.book-scroll {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
}

.book-scroll + .book-scroll {
  margin-top: 12rpx;
}

.book-row {
  display: flex;
  /* 左右留白放在内层，避免 scroll-view 因 padding 撑破 100% 宽度 */
  padding: 0 24rpx;
}

.book-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #f1f5f9;
  border-radius: 28rpx;
  transition: all 0.2s ease;
  flex-shrink: 0;
  white-space: nowrap;
}

.book-chip.active {
  background: var(--primary-grad);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

/* 专业行：用青蓝区分层级 */
.book-chip.major {
  font-size: 23rpx;
  padding: 8rpx 22rpx;
  background: #f5f7fa;
}

.book-chip.major.active {
  background: var(--want-grad);
  box-shadow: 0 8rpx 22rpx rgba(161, 140, 209, 0.26);
}

/* === 画布容器 === */
.canvas-container {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.commodity-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* === 加载状态 === */
.load-more {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  pointer-events: none;
}

/* === 空状态 === */
.empty-state {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
  pointer-events: none;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-light);
}

/* === 发布浮动按钮 === */
.publish-float {
  position: fixed;
  right: 24rpx;
  bottom: 180rpx;
  z-index: 999;
  animation: floatIn 0.4s ease-out, floatBounce 2.5s ease-in-out infinite 0.4s;
}

.publish-float-glow {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  background: var(--primary-grad);
  border-radius: 60rpx;
  opacity: 0.5;
  filter: blur(12rpx);
  animation: glowPulse 2s ease-in-out infinite;
  z-index: -1;
}

.publish-float-inner {
  display: flex;
  align-items: center;
  background: var(--primary-grad);
  border-radius: 52rpx;
  padding: 22rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 193, 126, 0.35);
}

.publish-icon {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
  margin-right: 10rpx;
}

.publish-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.3;
}

.publish-float:active {
  transform: scale(0.95);
}

@keyframes floatIn {
  from { opacity: 0; transform: translateY(40rpx) scale(0.8); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes floatBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.05); }
}


/* === 以物易物：类型筛选选中态 === */
.type-item.active.exchange {
  color: var(--exchange);
}


/* 技能服务：类型筛选选中态 */
.type-item.active.skill {
  color: var(--skill);
}

/* === 图片预热：离屏小图，不参与布局也不可见，仅用于提前把图拉进 image 缓存 === */
.preload-img {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 10rpx;
  height: 10rpx;
  opacity: 0;
  pointer-events: none;
}
