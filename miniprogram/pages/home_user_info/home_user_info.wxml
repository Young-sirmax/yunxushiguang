<!--pages/home_user_info/home_user_info.wxml-->
<view class="page-container">
  <view class="form-card card">
    <!-- 公开信息 -->
    <view class="section">
      <view class="section-header">公开信息</view>
      <view class="section-desc">头像和昵称将展示给其他用户，不含姓名、学号等隐私</view>

      <view class="form-item avatar-item">
        <text class="label">头像</text>
        <view class="avatar-upload" bindtap="chooseAvatar">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="avatar-placeholder">
            <text class="avatar-icon">+</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="label">昵称</text>
        <input value="{{userInfo.nickName}}" placeholder="对外展示的昵称" bindinput="onNickName"/>
      </view>
    </view>

    <!-- 实名信息 -->
    <view class="section">
      <view class="section-header">实名信息</view>
      <view class="section-desc">用于注册人工核验，不对其他用户公开</view>

      <view class="form-item">
        <text class="label">姓名</text>
        <input value="{{userInfo.realName}}" disabled class="disabled-input"/>
      </view>

      <view class="form-item">
        <text class="label">学号</text>
        <input value="{{userInfo.studentId}}" disabled class="disabled-input"/>
      </view>
      <text class="disabled-tip">姓名和学号注册后不可修改</text>
    </view>

    <!-- 联系方式 -->
    <view class="section">
      <view class="section-header">联系方式</view>
      <view class="section-desc">手机号仅向交易对方展示</view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input type="number" maxlength="11" value="{{userInfo.contact}}" placeholder="请输入11位手机号" bindinput="onContact"/>
      </view>
      <text wx:if="{{contactError}}" class="error-text">{{contactError}}</text>
    </view>

    <!-- 收款码 -->
    <view class="section">
      <view class="section-header">收款码</view>
      <view class="section-desc">上传收款码后，聊天时可向对方出示，加快交易流程</view>

      <view class="qrcode-upload-area" bindtap="choosePayCode">
        <block wx:if="{{userInfo.payCodeUrl}}">
          <image class="qrcode-img" src="{{userInfo.payCodeUrl}}" mode="aspectFit"/>
          <view class="qrcode-overlay">
            <text class="qrcode-overlay-text">点击更换</text>
          </view>
        </block>
        <view wx:else class="qrcode-placeholder">
          <text class="qrcode-plus">+</text>
          <text class="qrcode-tip">上传收款码</text>
        </view>
      </view>
      <view class="qrcode-actions" wx:if="{{userInfo.payCodeUrl}}">
        <text class="qrcode-action" bindtap="previewPayCode">预览</text>
        <text class="qrcode-action danger" bindtap="removePayCode">删除</text>
      </view>
    </view>

    <button class="btn-primary" bindtap="save" disabled="{{!canSave}}">保存</button>
  </view>
</view>