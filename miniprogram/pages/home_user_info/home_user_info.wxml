<!--pages/home_user_info/home_user_info.wxml-->
<view class="page-container">
  <view class="form-card card">
    <!-- 公开信息 -->
    <view class="section">
      <view class="section-header">公开信息</view>
      <view class="section-desc">头像和昵称将展示给其他用户，不含姓名、学号等隐私</view>

      <view class="form-item avatar-item">
        <text class="label">头像</text>
        <button class="avatar-upload avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{avatarUploading}}">
          <view class="avatar-box">
            <image wx:if="{{avatar.useImage}}" class="avatar-img" src="{{avatar.src}}" mode="aspectFill" binderror="onAvatarError"/>
            <view wx:else class="avatar-img avatar-letter" style="background:{{avatar.color}}">{{avatar.letter}}</view>
            <view wx:if="{{avatarUploading}}" class="avatar-mask">
              <view class="avatar-spinner"></view>
            </view>
          </view>
        </button>
      </view>

      <view class="form-item">
        <text class="label">昵称</text>
        <input value="{{userInfo.nickName}}" placeholder="对外展示的昵称" bindinput="onNickName"/>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="section">
      <view class="section-header">联系方式</view>
      <view class="section-desc">微信号会展示给交易对方；手机号仅用于账号找回，不对外展示</view>

      <view class="form-item">
        <text class="label">微信号</text>
        <input value="{{userInfo.wechat_id}}" placeholder="字母开头，6-20位字母/数字/_-" bindinput="onWechatId"/>
      </view>
      <text wx:if="{{wechatIdError}}" class="error-text">{{wechatIdError}}</text>

      <view class="form-item" wx:if="{{wechatDirty}}">
        <text class="label">确认微信号</text>
        <input value="{{wechatConfirm}}" placeholder="请再次输入微信号" bindinput="onWechatConfirm"/>
      </view>
      <text wx:if="{{wechatConfirmError}}" class="error-text">{{wechatConfirmError}}</text>

      <view class="form-item">
        <text class="label">手机号</text>
        <input type="number" maxlength="11" value="{{userInfo.phone}}" placeholder="选填，仅用于账号找回" bindinput="onPhone"/>
      </view>
      <text wx:if="{{phoneError}}" class="error-text">{{phoneError}}</text>
    </view>

    <!-- 学生认证 -->
    <view class="section verify-section">
      <view class="verify-header">
        <view class="section-header">学生认证</view>
        <view wx:if="{{userInfo.isStudentVerified}}" class="verified-badge">✓ 已认证</view>
        <view wx:elif="{{userInfo.studentVerifyStatus === 'pending'}}" class="pending-badge">审核中</view>
        <view wx:else class="unverified-badge">未认证</view>
      </view>
      <view class="section-desc">认证后可发布信息、查看联系方式，一次认证全平台生效</view>

      <block wx:if="{{userInfo.isStudentVerified}}">
        <view class="verified-info">
          <view class="verify-row">
            <text class="verify-label">学校</text>
            <text class="verify-value">{{userInfo.universityName || '已认证'}}</text>
          </view>
          <view class="verify-row">
            <text class="verify-label">姓名</text>
            <text class="verify-value masked">**{{userInfo.realName ? userInfo.realName.substring(1) : ''}}</text>
          </view>
          <view class="verify-row">
            <text class="verify-label">学号</text>
            <text class="verify-value masked">{{userInfo.studentId ? userInfo.studentId.substring(0,4) : ''}}********</text>
          </view>
          <view class="verified-tip">✓ 已通过学生身份认证，所有功能已解锁</view>
          <view class="global-tip">🌐 认证状态全平台生效，无需在其他页面重复认证</view>
        </view>
      </block>

      <block wx:elif="{{userInfo.studentVerifyStatus === 'pending'}}">
        <view class="pending-info">
          <view class="verify-progress">
            <view class="progress-dot active"></view>
            <view class="progress-line"></view>
            <view class="progress-dot active"></view>
            <view class="progress-line"></view>
            <view class="progress-dot"></view>
          </view>
          <view class="progress-labels">
            <text class="active">提交</text>
            <text class="active">审核中</text>
            <text>通过</text>
          </view>
          <view class="pending-tip">⏳ 认证审核中，预计24小时内完成</view>
          <view class="global-tip">🌐 审核通过后认证状态全平台自动生效，无需重复操作</view>
        </view>
      </block>

      <block wx:else>
        <!-- 未认证：填写信息并提交 -->
        <view class="verify-form">
          <view class="form-item">
            <text class="label">所在学校</text>
            <picker mode="selector" range="{{universityList}}" range-key="name" bindchange="onUniversityChange">
              <view class="picker-value {{selectedUniversity ? '' : 'placeholder'}}">
                {{selectedUniversity ? selectedUniversity.name : '请选择学校'}}
                <text class="arrow">›</text>
              </view>
            </picker>
          </view>

          <view class="form-item">
            <text class="label">姓名</text>
            <input value="{{verifyRealName}}" placeholder="请输入真实姓名" bindinput="onVerifyRealName"/>
          </view>

          <view class="form-item">
            <text class="label">学号</text>
            <input type="text" maxlength="10" value="{{verifyStudentId}}" placeholder="请输入10位学号" bindinput="onVerifyStudentId"/>
            <text wx:if="{{studentIdError}}" class="error-text">{{studentIdError}}</text>
          </view>

          <view class="form-item column">
            <text class="label">学生证照片</text>
            <view class="verify-upload">
              <view wx:if="{{verifyImage}}" class="verify-img-cell">
                <image src="{{verifyImage}}" mode="aspectFill" class="verify-thumb" bindtap="previewVerifyImage"/>
                <view class="verify-img-del" catchtap="deleteVerifyImage">×</view>
              </view>
              <view wx:else class="verify-upload-add" bindtap="chooseVerifyImage">
                <text class="verify-add-icon">+</text>
                <text class="verify-add-label">上传学生证/校园卡</text>
              </view>
            </view>
            <view class="verify-privacy-tip">🔒 证件照片仅用于人工审核，严格保密</view>
          </view>

          <view class="verify-advantages">
            <view class="adv-chip">📱 发布信息</view>
            <view class="adv-chip">💬 联系交易</view>
            <view class="adv-chip">🛡️ 信任标识</view>
          </view>

          <button class="btn-primary verify-submit" bindtap="submitVerify" disabled="{{!canSubmitVerify || isSubmitting}}">
            <view wx:if="{{isSubmitting}}" class="verify-btn-loading">
              <view class="verify-btn-spinner"></view>
              <text>提交中...</text>
            </view>
            <text wx:else>提交认证</text>
          </button>
        </view>
      </block>
    </view>

    <button class="btn-primary" bindtap="save" disabled="{{!canSave}}">保存</button>
  </view>
</view>