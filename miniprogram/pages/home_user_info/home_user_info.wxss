/* pages/home_user_info/home_user_info.wxss */
.page-container { padding: 24rpx; }

.form-card { padding: 32rpx; }

.section {
  margin-bottom: 48rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.section:last-of-type {
  border-bottom: none;
  margin-bottom: 32rpx;
}

.section-header {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-item.column {
  flex-direction: column;
  align-items: stretch;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text);
  flex-shrink: 0;
}

.form-item.column .label {
  width: auto;
  margin-bottom: 12rpx;
}

.form-item input {
  flex: 1;
  height: 80rpx;
  background: var(--fill);
  border: 2rpx solid transparent;
  border-radius: var(--radius);
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text);
  transition: all 0.2s ease;
}

.form-item input:focus {
  border-color: var(--primary);
  background: var(--white);
  box-shadow: 0 0 0 6rpx rgba(var(--primary-rgb), 0.08);
}

.form-item input.disabled-input {
  color: var(--text-light);
  background: var(--fill);
}

.disabled-tip {
  display: block;
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: -8rpx;
}

.error-text {
  display: block;
  font-size: 24rpx;
  color: var(--error);
  margin-top: -16rpx;
  margin-bottom: 16rpx;
}

.avatar-item {
  display: flex;
  align-items: center;
}

.avatar-upload {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
}

/* 字母头像兜底：昵称首字符 + 稳定底色 */
.avatar-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--white);
  font-size: 44rpx;
  font-weight: 600;
  border: none;
}

/* 遮罩与头像严格对齐，上传中盖一层转圈 */
.avatar-box {
  position: relative;
  display: flex;
}

.avatar-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: var(--white);
  border-radius: 50%;
  animation: avatar-spin 0.8s linear infinite;
}

@keyframes avatar-spin {
  to { transform: rotate(360deg); }
}

.picker-value {
  flex: 1;
  height: 80rpx;
  background: var(--fill);
  border: 2rpx solid transparent;
  border-radius: var(--radius);
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text);
  transition: all 0.2s ease;
}

.picker-value:active {
  border-color: var(--primary);
  background: var(--white);
}

.picker-value.placeholder {
  color: var(--text-light);
}

.picker-value .arrow {
  margin-left: auto;
  color: var(--text-light);
  font-size: 32rpx;
}

/* 学生认证样式 */
.verify-section {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--bg) 100%);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  border: 1rpx solid rgba(var(--primary-rgb), 0.12);
  margin-bottom: 32rpx;
}

.verify-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.verify-header .section-header {
  margin-bottom: 0;
}

.verified-badge {
  font-size: 24rpx;
  color: var(--white);
  background: var(--primary-grad);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
  box-shadow: var(--shadow-primary);
}

.pending-badge {
  font-size: 24rpx;
  color: var(--warning-dark);   /* 状态/提示语义，不是价格 */
  background: var(--warning-soft);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}

.unverified-badge {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--fill);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-weight: 500;
}

.verified-info {
  background: var(--white);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: var(--shadow-sm);
}

.verify-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.verify-row:last-of-type {
  border-bottom: none;
}

.verify-label {
  font-size: 26rpx;
  color: var(--text-light);
}

.verify-value {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.verify-value.masked {
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.verified-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--primary-dark);
  text-align: center;
  padding: 16rpx;
  background: var(--primary-light);
  border-radius: var(--radius);
}

.pending-info {
  background: var(--white);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: var(--shadow-sm);
}

.verify-progress {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.progress-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--fill-strong);
}

.progress-dot.active {
  background: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(var(--primary-rgb), 0.15);
}

.progress-line {
  width: 80rpx;
  height: 4rpx;
  background: var(--fill-strong);
  border-radius: 2rpx;
}

.progress-line.active {
  background: var(--primary);
}

.progress-labels {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.progress-labels .active {
  color: var(--primary);
  font-weight: 600;
}

.pending-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--warning);
  text-align: center;
}

.global-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
  padding: 12rpx;
  background: var(--bg);
  border-radius: var(--radius);
}

.verify-form {
  margin-top: 20rpx;
}

.verify-upload {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.verify-img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.verify-thumb {
  width: 100%;
  height: 100%;
  border-radius: var(--radius);
}

.verify-img-del {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.verify-upload-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed rgba(var(--primary-rgb), 0.35);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--white);
  transition: all 0.2s ease;
}

.verify-upload-add:active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.verify-add-icon {
  font-size: 60rpx;
  color: var(--primary);
  font-weight: 300;
  line-height: 1;
}

.verify-add-label {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
  text-align: center;
  padding: 0 16rpx;
}

.verify-privacy-tip {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.verify-advantages {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.adv-chip {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--white);
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(var(--primary-rgb), 0.2);
}

.verify-submit {
  margin-top: 32rpx;
  width: 100%;
}

.verify-btn-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.verify-btn-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  border-top-color: var(--white);
  border-radius: 50%;
  animation: verify-spin 0.8s linear infinite;
}

@keyframes verify-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.qrcode-upload-area {
  width: 280rpx;
  height: 280rpx;
  background: var(--fill);
  border-radius: var(--radius-lg);
  border: 2rpx dashed var(--text-light);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.qrcode-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.qrcode-plus {
  font-size: 64rpx;
  color: var(--text-light);
  font-weight: 300;
  line-height: 1;
}

.qrcode-tip {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

.qrcode-img {
  width: 100%;
  height: 100%;
}

.qrcode-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qrcode-overlay-text {
  font-size: 24rpx;
  color: var(--white);
}

.qrcode-actions {
  display: flex;
  gap: 32rpx;
}

.qrcode-action {
  font-size: 26rpx;
  color: var(--primary-dark);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-light);
}

.qrcode-action.danger {
  color: var(--error);
  background: var(--error-soft);
}
/* 头像改为微信官方 chooseAvatar 按钮后的样式重置 */
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  border-radius: 0;
  /* button 默认 overflow:hidden，避免裁掉头像描边/遮罩 */
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.avatar-btn::after {
  border: none;
}
/* 按下有缩放+高亮反馈，杜绝“点了没反应”的观感 */
.avatar-btn:active {
  opacity: 0.85;
  transform: scale(0.92);
}
.avatar-btn {
  transition: transform 0.15s ease, opacity 0.15s ease;
}
/* 上传中按钮被 disabled，但样式保持原样（只靠遮罩转圈表达进行中） */
.avatar-btn[disabled] {
  opacity: 1;
  background: transparent;
}
