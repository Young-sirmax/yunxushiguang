/* pages/expert_home/expert_home.wxss —— 技能达人主页 */
page {
  background: var(--bg);
}

.page-container {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: var(--bg);
}

/* 头部 */
.eh-header {
  position: relative;
  height: 260rpx;
  overflow: hidden;
}

.eh-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* 达人页保留「暖金 → 橙红」身份色：两端都取自语义令牌，不再自带一组金黄 */
  background: linear-gradient(135deg, var(--warning) 0%, var(--price) 100%);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

.eh-profile {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 70rpx 40rpx 0;
}

.eh-avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.6);
  background: var(--white);
  margin-right: 26rpx;
  flex-shrink: 0;
}

.eh-meta {
  flex: 1;
  min-width: 0;
}

.eh-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.eh-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--white);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.18);
}

.eh-expert-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  color: var(--type-skill-text);
  background: var(--type-skill-soft);
}

.eh-sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.eh-school,
.eh-rating {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

/* 卡片 */
.eh-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 30rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.eh-card:first-of-type {
  margin-top: -50rpx;
  position: relative;
  z-index: 2;
}

.eh-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.eh-skills {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.eh-skill {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: var(--type-skill-text);
  background: var(--type-skill-soft);
  font-weight: 500;
}

.eh-intro {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  word-break: break-all;
}

.eh-quote {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--type-skill-text);
}

.eh-certs {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.eh-cert {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: var(--fill);
}

/* 技能服务列表 */
.eh-post {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--bg);
}

.eh-post:last-child {
  border-bottom: none;
}

.eh-post-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: var(--fill);
  flex-shrink: 0;
}

.eh-post-info {
  flex: 1;
  min-width: 0;
}

.eh-post-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.eh-post-price {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--type-skill-text);
}

.eh-post-time {
  display: block;
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

/* 评价 */
.eh-review {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--bg);
}

.eh-review:last-child {
  border-bottom: none;
}

.eh-review-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.eh-review-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: var(--fill);
}

.eh-review-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.eh-review-stars {
  font-size: 24rpx;
  color: var(--warning);
  letter-spacing: 2rpx;
}

.eh-review-text {
  display: block;
  font-size: 27rpx;
  color: var(--text);
  line-height: 1.6;
  word-break: break-all;
}

.eh-review-time {
  display: block;
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.eh-empty {
  font-size: 26rpx;
  color: var(--text-light);
  padding: 20rpx 0;
}

/* 自己的主页操作 */
.eh-actions {
  padding: 0 24rpx;
}

.eh-action-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--type-skill-text);
  background: var(--type-skill-soft);
}
