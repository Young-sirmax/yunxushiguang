/**app.wxss —— 全局设计系统（青春校园风 · 活力青绿）**/
/* 色板全部收敛到 styles/theme.wxss，本文件不再定义任何色值 */
@import "./styles/theme.wxss";

.container {
  padding: 24rpx;
}

/* === 卡片 === */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* === 主按钮（胶囊形 · 渐变 · 高光 · 按压反馈） === */
.btn-primary {
  background: var(--primary-grad);
  color: var(--white);
  border-radius: var(--radius-pill);
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-primary);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 32rpx;
}

/* 顶部高光 */
.btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.28), transparent);
  border-radius: inherit;
}

/* 流光 */
.btn-primary::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  animation: shimmer 2.8s infinite;
}

.btn-primary:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-primary-active);
}

/* 禁用态：不再用「褪色绿」，改为中性填充 + 弱文字，与主色体系解耦 */
.btn-primary[disabled] {
  background: var(--fill-strong);
  color: var(--text-light);
  box-shadow: none;
}

.btn-primary[disabled]::before,
.btn-primary[disabled]::after {
  display: none;
}

/* === 次级按钮（白底描边） === */
.btn-default {
  background: var(--bg-card);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-pill);
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 32rpx;
  transition: all 0.2s ease;
}

.btn-default::after {
  border: none;
}

.btn-default:active {
  transform: scale(0.96);
  background: var(--primary-light);
}

/* === 文字按钮 === */
.btn-text {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 500;
  background: transparent;
  border: none;
  padding: 0;
  line-height: inherit;
}

.btn-text::after {
  border: none;
}

/* === 危险按钮（红色渐变胶囊） === */
.btn-danger {
  background: var(--error-grad);
  color: var(--white);
  border-radius: var(--radius-pill);
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-danger);
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 32rpx;
}

.btn-danger::after {
  border: none;
}

.btn-danger:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-danger-active);
}

/* === 小型按钮 === */
.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
}

/* === 通用徽章（认证/状态） === */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.5;
  flex-shrink: 0;
}

/* 已认证 = 成功语义（与主色同源，但走语义令牌，语义变了不会被主色误带） */
.badge-verified {
  color: var(--success);
  background: var(--success-soft);
}

.badge-pending {
  color: var(--warning);
  background: var(--warning-soft);
}

.badge-danger {
  color: var(--danger);
  background: var(--danger-soft);
}

.badge-info {
  color: var(--info);
  background: var(--info-soft);
}

/* 交易状态标签：已预订 = 警告语义 / 已完成 = 中性弱化（不再抢价格与主色的视觉位） */
.badge-booked {
  color: var(--warning);
  background: var(--warning-soft);
}

.badge-done {
  color: var(--text-light);
  background: var(--fill);
}

/* === 价格文本 ===
   全站价格只有 --price 一色：卡片价格、详情价格、求购预算共用下面两个类。
   .price-want 保留类名（历史用法），颜色与 .price-text 一致，不再另起绿价。 */
.price-text,
.price-want {
  color: var(--price);
  font-weight: 700;
}

/* === 通用空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  box-shadow: var(--shadow-inset-primary);
}

.empty-icon {
  font-size: 88rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-light);
  text-align: center;
  line-height: 1.6;
}

/* === 通用输入框 === */
.input-base {
  height: 88rpx;
  background: var(--fill);
  border: 2rpx solid transparent;
  border-radius: var(--radius);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  transition: all 0.2s ease;
}

.input-base:focus {
  border-color: var(--primary);
  background: var(--white);
  box-shadow: var(--ring-primary);
}

/* === 页面区块标题 === */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

/* 可选：配合 .title-bar 启用左侧绿色竖条装饰 */
.section-title.title-bar {
  display: flex;
  align-items: center;
}

.section-title.title-bar::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--primary-grad);
  margin-right: 14rpx;
  flex-shrink: 0;
}

/* === 布局工具 === */
.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* === 文本工具 === */
.text-primary { color: var(--primary); }
.text-warning { color: var(--warning); }
.text-danger { color: var(--danger); }
.text-secondary { color: var(--text-secondary); }
.text-light { color: var(--text-light); }

.text-center { text-align: center; }
.text-right { text-align: right; }

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* === 通用渐变文字 === */
.gradient-text {
  background: var(--primary-grad);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* === 通用页面入场动画 === */
@keyframes slideUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 150%; }
}

@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.35); }
  100% { transform: scale(1); }
}

/* === 图片骨架 / 淡入（统一占位，杜绝白块等待） === */
.img-skel {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: var(--fill-strong);
  background-image: var(--skel-sweep);
  background-size: 200% 100%;
  animation: imgSkelSweep 1.4s ease-in-out infinite;
}

@keyframes imgSkelSweep {
  from { background-position: 200% 0; }
  to { background-position: -60% 0; }
}

/* 加载完成淡入：onload 后加上 .is-loaded */
.img-fade {
  opacity: 0;
  transition: opacity 0.28s ease;
}

.img-fade.is-loaded {
  opacity: 1;
}

/* 静态占位底色：列表缩略图直接复用（零 JS 成本，也不会出现白块） */
.img-ph {
  background-color: var(--fill-strong);
}
